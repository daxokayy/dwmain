local function getPlayerBase(plr)
    local plrbase = nil

    for _,v in ipairs(workspace.Bases:GetDescendants()) do

        if v:IsA("UnionOperation") and v.Name == "Board" then
            local plotinfo = v:FindFirstChild("PlotInfo")

            if not plotinfo then 
                continue
            else
                local playerplot = plotinfo:FindFirstChild("Container"):FindFirstChild("PlayerName")

                if playerplot.Text == plr.Name then
                    plrbase = v.Parent
                end
            end
        end

    end

    return plrbase
end

local brModule = require(game:GetService("ReplicatedStorage").Configurations.Modules.ItemsConfigurations)
local function findBest(_module, folder)
    local areaPriority = {
        Common = 1,
        Uncommon = 2,
        Rare = 3,
        Epic = 4,
        Legendary = 5,
        Mythic = 6,
        Divine = 7,
        Secret = 8,
        OG = 9,
        Celestial = 10,
        Ancient = 11,
        Transcendent = 12,
        Eternal = 13,
        Immortal = 14,
    }

    local bestItem
    local bestPriority = 0

    for _, item in ipairs(folder:GetChildren()) do
        local info = _module[item.Name]

        if info then
            local priority = areaPriority[info.Area] or 0

            if priority >= 11 then
                bestPriority = priority
                bestItem = item
            end
        end
    end

    return bestItem
end

