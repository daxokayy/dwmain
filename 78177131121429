local stateevent = game:GetService("ReplicatedStorage").Network.RemoteEvents.MutationState
local actionevent = game:GetService("ReplicatedStorage").Network.RemoteEvents.MutationAction
local selectedmutation = nil
local togglestate = false
local targetmutation = nil
local mutationUpdated = false
local mutationTick = 0


home:CreateSection({ name = "Mutations" })
home:CreateDropdown({
    name = "Select Mutation",
    multiSelect = false,
    options = { "Gold", "Diamond", "Galaxy", "Lava", "Rainbow" },
    value = { "mutation" },
    callback = function(selected)
        
        selectedmutation = selected

    end,
})
home:CreateButton({
    name = "Force Mutation",
    callback = function()

        local heldTool = character:FindFirstChildOfClass("Tool")

        if not heldTool then
            firesignal(
                game:GetService("ReplicatedStorage").Network.RemoteEvents.Announcement.OnClientEvent,
                "daxware: Please hold a brainrot.",
                Color3.new(1, 0.32941177487373, 0.32941177487373)
            )
            return
        end

        local toolName = heldTool.Name
        local startingPos = hrp.CFrame
        local attempts = 0

        while true do

            attempts += 1
            print("Attempt:", attempts)

            local oldTick = mutationTick

            hrp.CFrame = CFrame.new(197, -71, 15)

            task.wait(0.15)

            actionevent:FireServer("requestState")


            repeat
                task.wait()
            until mutationTick > oldTick

            print("Rolled:", targetmutation)


            if targetmutation == selectedmutation then

                window:Notify({
                    title = "Success!",
                    content = "Found " .. targetmutation .. " after " .. attempts .. " attempts.",
                    Duration = 5,
                })

                actionevent:FireServer("mutate")

                hrp.CFrame = startingPos
                break
            end


            print("Wrong mutation, taking back")

            actionevent:FireServer("takeback")
            task.wait(0.5)


            repeat
                task.wait()
            until backpack:FindFirstChild(toolName)


            local returnedTool = backpack:FindFirstChild(toolName)

            print("Returned:", returnedTool.Name)

            character.Humanoid:EquipTool(returnedTool)


            repeat
                task.wait()
            until returnedTool.Parent == character


            print("Equipped")

            task.wait(0.25)

        end
    end,
})

