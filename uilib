        UDim2.new(1, -110, 0, 0),
        UDim2.new(0, 92, 1, 0),
        C.Muted
    )
    version.TextXAlignment = Enum.TextXAlignment.Right
    local function fit()
        local viewport = w.gui.AbsoluteSize
        w.fit = math.min(
            opt(config, "Scale", 1),
            math.max(0.1, (viewport.X - 24) / size.X),
            math.max(0.1, (viewport.Y - 24) / size.Y)
        )
        if w.ready then
            w.scale.Scale = w.fit * (w.visible and 1 or 0.96)
        end
        if w.positionGoal then
            w.positionGoal = w:_ClampPosition(w.positionGoal)
        end
    end
    w.refit = fit
    listen(w, w.gui:GetPropertyChangedSignal("AbsoluteSize"), fit)
    fit()
    local center = w.root.Position
    w.root.Position = UDim2.new(
        center.X.Scale,
        center.X.Offset - size.X * w.fit / 2,
        center.Y.Scale,
        center.Y.Offset - size.Y * w.fit / 2
    )
    local drag, start, initial
    w.positionGoal = w:_ClampPosition(w.root.Position)
    w.root.Position = w.positionGoal
    listen(w, w.header.InputBegan, function(input)
        if
            w.ready
            and w.visible
            and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch)
            and input.Position.X < settingsState[w].button.AbsolutePosition.X
        then
            drag = input
            start = input.Position
            initial = w.positionGoal
        end
    end)
    listen(w, UIS.InputChanged, function(input)
        if
            drag
            and (
                input == drag
                or (
                    drag.UserInputType == Enum.UserInputType.MouseButton1
                    and input.UserInputType == Enum.UserInputType.MouseMovement
                )
            )
        then
            local d = input.Position - start
            w.positionGoal = w:_ClampPosition(
                UDim2.new(
                    initial.X.Scale,
                    initial.X.Offset + d.X,
                    initial.Y.Scale,
                    initial.Y.Offset + d.Y
                )
            )
        end
    end)
    listen(w, UIS.InputEnded, function(input)
        if input == drag then
            drag = nil
        end
    end)
    listen(w, UIS.WindowFocusReleased, function()
        drag = nil
    end)
    listen(w, mini.Activated, function()
        w:Minimize(not w.minimized)
    end)
    listen(w, close.Activated, function()
        w:SetVisible(false)
    end)
    listen(w, UIS.InputBegan, function(input, processed)
        if
            w.ready
            and not processed
            and not UIS:GetFocusedTextBox()
            and not w.root:GetAttribute("CapturingKey")
            and input.KeyCode == w.toggleKey
        then
            w:SetVisible(not w.visible)
        end
    end)
    for _, button in
        {
            mini,
            close,
        }
    do
        for _, glyph in button:GetChildren() do
            if glyph:IsA("Frame") then
                listen(w, button.MouseEnter, function()
                    animate(w, glyph, {
                        BackgroundColor3 = button == close and w.accent or C.Text,
                    }, 0.12)
                end)
                listen(w, button.MouseLeave, function()
                    animate(w, glyph, {
                        BackgroundColor3 = C.Muted,
                    }, 0.12)
                end)
            end
        end
    end
    listen(w, RunService.RenderStepped, function(dt)
        if not w.visible or w.destroyed then
            return
        end
        local alpha = 1 - math.exp(-28 * math.min(dt, 0.1))
        if w.root.Position ~= w.positionGoal then
            local p = w.root.Position:Lerp(w.positionGoal, alpha)
            if
                math.abs(p.X.Offset - w.positionGoal.X.Offset)
                    + math.abs(p.Y.Offset - w.positionGoal.Y.Offset)
                < 0.1
            then
                p = w.positionGoal
            end
            w.root.Position = p
        end
        for _, tick in pairs(w.ticks) do
            tick(alpha, dt)
        end
    end)
    listen(w, w.gui.Destroying, function()
        if not w.destroyed then
            w:Destroy()
        end
    end)
    task.defer(function()
        if w.destroyed then
            return
        end
        if opt(config, "Loading", true) then
            w:_Load()
        else
            w.ready = true
            w.root.Visible = true
            w:SetVisible(true)
        end
    end)
    w.brandAccent = styleBrand(w.header.Title, w.accent, function(signal, fn)
        return listen(w, signal, fn)
    end)
    local topbarContext = {
        connect = function(signal, fn)
            return listen(w, signal, fn)
        end,
        tween = function(object, props, duration)
            animate(w, object, props, duration)
        end,
        accent = function()
            return w.accent
        end,
    }
    animateTopbar(settingsState[w].button, settingsState[w].icon, "settings", topbarContext)
    animateTopbar(mini, mini:FindFirstChild("Icon"), "minimize", topbarContext)
    animateTopbar(close, close:FindFirstChild("Icon"), "close", topbarContext)
    settingsState[w].page = installSettings({
        root = w.root,
        body = w.body,
        connect = function(signal, callback)
            return listen(w, signal, callback)
        end,
        tween = function(object, props, duration)
            animate(w, object, props, duration)
        end,
        accent = function()
            return w.accent
        end,
        key = function()
            return w.toggleKey
        end,
        scale = function()
            return opt(config, "Scale", 1)
        end,
        setKey = function(key)
            w:SetToggleKey(key)
        end,
        setAccent = function(color)
            w:SetAccent(color)
        end,
        setScale = function(value)
            w:SetScale(value)
        end,
    })
    listen(w, settingsState[w].button.Activated, function()
        if w.minimized or not w.ready then
            return
        end
        if settingsState[w].page.Visible then
            settingsState[w].page.Visible = false
            if settingsState[w].previous and not settingsState[w].previous.destroyed then
                w:SelectTab(settingsState[w].previous)
            end
        else
            settingsState[w].previous = w.selected
            w.selected = nil
            for _, tab in ipairs(w.tabs) do
                tab.page.Visible = false
                tab.underline.Visible = false
                animate(w, tab.button, { TextColor3 = C.Muted }, 0.17)
            end
            settingsState[w].page.Visible = true
            settingsState[w].page.Position = UDim2.fromOffset(8, 0)
            animate(w, settingsState[w].page, { Position = UDim2.new() }, 0.2)
        end
    end)
    return w
end

function Window:SetAccent(color)
    assert(typeof(color) == "Color3", "Accent must be a Color3")
    captureAccent(self.accentBindings, self.accentSeen, self.root, self.accent)
    self.accent = color
    self.root:SetAttribute(
        "SettingsRevision",
        (self.root:GetAttribute("SettingsRevision") or 0) + 1
    )
    if self.brandAccent then
        animate(self, self.brandAccent, { Value = color }, 0.18)
    end
    for object, properties in pairs(self.accentBindings) do
        if object.Parent and not fixedColor(object) then
            local goals = {}
            for property in pairs(properties) do
                goals[property] = color
            end
            animate(self, object, goals, 0.18)
        end
    end
    for _, tab in ipairs(self.tabs) do
        if not tab.destroyed then
            animate(self, tab.underline, { BackgroundColor3 = color }, 0.18)
            if self.selected == tab then
                animate(self, tab.button, { TextColor3 = color }, 0.18)
            end
            for _, element in ipairs(tab.elements) do
                if
                    not element.destroyed
                    and element.kind == "preview"
                    and element.mode == "aim"
                then
                    local stroke = element.circle:FindFirstChildOfClass("UIStroke")
                    if stroke then
                        animate(self, stroke, { Color = color }, 0.18)
                    end
                    for _, visual in ipairs({ element.line, element.center, element.dot }) do
                        animate(self, visual, { BackgroundColor3 = color }, 0.18)
                    end
                end
            end
        end
    end
    for _, knob in ipairs(self.root:GetDescendants()) do
        if knob:GetAttribute("ToggleKnob") then
            animate(self, knob, {
                BackgroundColor3 = toggleKnobColor(
                    color,
                    knob.Parent.Parent:GetAttribute("Value") == true
                ),
            }, 0.18)
        end
    end
end

function Window:SetScale(value)
    self.config.Scale = math.clamp(value, 0.65, 1.25)
    self.refit()
    self.root:SetAttribute(
        "SettingsRevision",
        (self.root:GetAttribute("SettingsRevision") or 0) + 1
    )
end

function Window:SetToggleKey(key)
    assert(typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode, "Expected a KeyCode")
    self.toggleKey = key
    self.root:SetAttribute(
        "SettingsRevision",
        (self.root:GetAttribute("SettingsRevision") or 0) + 1
    )
end

function Window:GetSettings()
    return {
        Accent = self.accent:ToHex(),
        Scale = opt(self.config, "Scale", 1),
        ToggleKey = self.toggleKey.Name,
    }
end

function Window:ApplySettings(data)
    if type(data) ~= "table" then
        return false, "Settings must be a table"
    end
    local accent, scale, key
    if data.Accent ~= nil then
        if type(data.Accent) ~= "string" or not data.Accent:match("^%x%x%x%x%x%x$") then
            return false, "Invalid accent color"
        end
        accent = Color3.fromHex(data.Accent)
    end
    if data.Scale ~= nil then
        if
            type(data.Scale) ~= "number"
            or data.Scale ~= data.Scale
            or math.abs(data.Scale) == math.huge
        then
            return false, "Invalid UI scale"
        end
        scale = math.clamp(data.Scale, 0.65, 1.25)
    end
    if data.ToggleKey ~= nil then
        if type(data.ToggleKey) ~= "string" then
            return false, "Invalid keybind"
        end
        local ok, result = pcall(function()
            return Enum.KeyCode[data.ToggleKey]
        end)
        if not ok or not result or result == Enum.KeyCode.Unknown then
            return false, "Invalid keybind"
        end
        key = result
    end
    if accent then
        self:SetAccent(accent)
    end
    if scale then
        self:SetScale(scale)
    end
    if key then
        self:SetToggleKey(key)
    end
    return true
end

function Window:_ClampPosition(position, targetSize)
    local viewport = self.gui.AbsoluteSize
    local scale = self.fit or 1
    local width = (targetSize and targetSize.X or self.root.Size.X.Offset) * scale
    local x = position.X.Scale * viewport.X + position.X.Offset
    local y = position.Y.Scale * viewport.Y + position.Y.Offset
    return UDim2.fromOffset(
        math.clamp(x, 8, math.max(8, viewport.X - width - 8)),
        math.clamp(y, 8, math.max(8, viewport.Y - 54 * scale - 8))
    )
end

function Window:SetVisible(value)
    if self.destroyed or not self.ready then
        return
    end
    self.visible = value == true
    self.token += 1
    local token = self.token
    self.root.Visible = true
    animate(self, self.root, {
        GroupTransparency = self.visible and 0 or 1,
    }, 0.24, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    animate(self, self.scale, {
        Scale = self.fit * (self.visible and 1 or 0.96),
    }, 0.24, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    animate(self, self.outline, {
        Transparency = self.visible and 0 or 1,
    }, 0.24, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    task.delay(0.26, function()
        if not self.destroyed and token == self.token and not self.visible then
            self.root.Visible = false
        end
    end)
end

function Window:Minimize(value)
    if self.destroyed or not self.ready then
        return
    end
    self.minimized = value == true
    settingsState[self].button.Active = not self.minimized
    animate(self, settingsState[self].icon, { ImageTransparency = self.minimized and 1 or 0 }, 0.22)
    self.minToken = (self.minToken or 0) + 1
    local token = self.minToken
    self.positionGoal =
        self:_ClampPosition(self.positionGoal, self.minimized and Vector2.new(276, 54) or self.size)
    self.headerDivider.Visible = not self.minimized
    if not self.minimized then
        self.nav.Visible = true
        self.body.Visible = true
        self.footer.Visible = true
    end
    animate(self, self.root, {
        Size = self.minimized and UDim2.fromOffset(276, 54)
            or UDim2.fromOffset(self.size.X, self.size.Y),
    }, 0.32, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
    task.delay(0.32, function()
        if not self.destroyed and token == self.minToken and self.minimized then
            self.nav.Visible = false
            self.body.Visible = false
            self.footer.Visible = false
        end
    end)
end

function Window:SetStatus(text)
    if not self.destroyed then
        self.status.Text = tostring(text)
    end
end

function Window:Destroy()
    if self.destroyed then
        return
    end
    self.destroyed = true
    self.unloaded = true
    disconnect(self)
    for object in pairs(self.tweens) do
        cancel(self, object)
    end
    table.clear(self.ticks)
    for _, tab in ipairs(self.tabs) do
        tab:Destroy()
    end
    self.gui:Destroy()
end
Window.Unload = Window.Destroy

function Window:AddTab(config)
    assert(not self.destroyed, "Window is destroyed")
    if type(config) == "string" then
        config = {
            Name = config,
        }
    end
    config = config or {}
    assert(
        string.lower(tostring(opt(config, "Name", ""))) ~= "settings",
        "Settings is a built-in page managed by the library"
    )
    local index = #self.tabs + 1
    local tab = setmetatable({
        window = self,
        connections = {},
        elements = {},
        destroyed = false,
        name = opt(config, "Name", "Tab " .. index),
    }, Tab)
    tab.button = hit(
        self.nav,
        "Tab" .. index,
        UDim2.new(),
        UDim2.fromOffset(
            opt(config, "Width", index == 1 and 150 or math.max(78, #tab.name * 9 + 35)),
            38
        )
    )
    tab.button.Text = tab.name
    tab.button.Font = Enum.Font.Gotham
    tab.button.TextSize = 14
    tab.button.TextColor3 = C.Muted
    tab.button.LayoutOrder = index
    tab.underline = make("Frame", {
        Name = "Underline",
        BackgroundColor3 = self.accent,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, -2),
        Size = UDim2.new(1, 0, 0, 2),
        Visible = false,
    }, tab.button)
    tab.page = make("Frame", {
        Name = tab.name .. "Page",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
    }, self.body)
    label(
        tab.page,
        "Title",
        tab.name,
        26,
        UDim2.fromOffset(19, 17),
        UDim2.new(1, -38, 0, 28),
        C.Text,
        true
    )
    label(
        tab.page,
        "Description",
        opt(config, "Description", ""),
        14,
        UDim2.fromOffset(19, 46),
        UDim2.new(1, -38, 0, 19),
        C.Subtle
    )
    local iconName = opt(config, "Icon", nil)
    if iconName then
        tab.icon = addIcon(tab.page.Title, iconName, UDim2.new(), 22)
        tab.icon.ImageColor3 = C.Muted
        local function alignIcon()
            local title = tab.page.Title
            local width =
                game:GetService("TextService")
                    :GetTextSize(title.Text, title.TextSize, title.Font, Vector2.new(10000, 100)).X
            tab.icon.Position = UDim2.new(0, width + 8, 0.5, -11)
        end
        listen(tab, tab.page.Title:GetPropertyChangedSignal("Text"), alignIcon)
        listen(tab, tab.page.Title:GetPropertyChangedSignal("TextSize"), alignIcon)
        alignIcon()
    end
    tab.columns = {}
    for _, which in
        {
            "left",
            "right",
        }
    do
        local column = make("ScrollingFrame", {
            Name = which == "left" and "LeftContent" or "RightContent",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = which == "left" and UDim2.fromOffset(19, 76) or UDim2.new(0.5, 5, 0, 76),
            Size = which == "left" and UDim2.new(0.5, -30, 1, -87) or UDim2.new(0.5, -22, 1, -87),
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = self.accent,
        }, tab.page)
        make("UIPadding", {
            PaddingTop = UDim.new(0, 1),
            PaddingLeft = UDim.new(0, 1),
            PaddingRight = UDim.new(0, 1),
            PaddingBottom = UDim.new(0, 2),
        }, column)
        make("UIListLayout", {
            Name = "GroupLayout",
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 12),
        }, column)
        tab.columns[which] = column
    end
    listen(tab, tab.button.Activated, function()
        self:SelectTab(tab)
    end)
    listen(tab, tab.button.MouseEnter, function()
        if self.selected ~= tab then
            animate(self, tab.button, {
                TextColor3 = C.Text,
            }, 0.12)
        end
    end)
    listen(tab, tab.button.MouseLeave, function()
        animate(self, tab.button, {
            TextColor3 = self.selected == tab and self.accent or C.Muted,
        }, 0.12)
    end)
    table.insert(self.tabs, tab)
    if not self.selected then
        self:SelectTab(tab, true)
    end
    return tab
end

function Window:SelectTab(tab, initial)
    if self.destroyed then
        return
    end
    if type(tab) == "string" then
        for _, item in ipairs(self.tabs) do
            if item.name == tab then
                tab = item
                break
            end
        end
    end
    assert(type(tab) == "table" and tab.window == self and not tab.destroyed, "Invalid tab")
    if self.selected == tab then
        return
    end
    if settingsState[self].page then
        settingsState[self].page.Visible = false
        self.root:SetAttribute("CapturingKey", false)
    end
    local previous = self.selected
    self.selected = tab
    for _, item in ipairs(self.tabs) do
        if not item.destroyed then
            cancel(self, item.page)
            item.page.Position = UDim2.new()
            item.page.Visible = item == tab
            item.underline.Visible = item == tab
            animate(self, item.button, {
                TextColor3 = item == tab and self.accent or C.Muted,
            }, 0.17)
        end
    end
    tab.underline.Size = UDim2.new(0, 0, 0, 2)
    animate(self, tab.underline, {
        Size = UDim2.new(1, 0, 0, 2),
    }, 0.19)
    if previous and not initial then
        tab.page.Position = UDim2.fromOffset(10, 0)
        animate(self, tab.page, {
            Position = UDim2.new(),
        }, 0.2)
    end
end

function Tab:SetTitle(value)
    self.name = tostring(value)
    self.page.Title.Text = self.name
    self.button.Text = self.name
end

function Tab:SetDescription(value)
    self.page.Description.Text = tostring(value)
end

function Tab:Destroy()
    if self.destroyed then
        return
    end
    self.destroyed = true
    disconnect(self)
    for _, item in ipairs(self.elements) do
        item:Destroy()
    end
    cancel(self.window, self.page)
    cancel(self.window, self.button)
    cancel(self.window, self.underline)
    self.page:Destroy()
    self.button:Destroy()
    if self.window.selected == self then
        self.window.selected = nil
        if not self.window.destroyed then
            for _, tab in ipairs(self.window.tabs) do
                if not tab.destroyed then
                    self.window:SelectTab(tab)
                    break
                end
            end
        end
    end
end

function Tab:AddGroup(config)
    assert(not self.destroyed, "Tab is destroyed")
    config = config or {}
    local g = setmetatable({
        window = self.window,
        tab = self,
        connections = {},
        controls = {},
        destroyed = false,
