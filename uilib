    )
    c.hit = hit(f, "Hit")
    local track = make("Frame", {
        Name = "Track",
        BackgroundColor3 = C.Track,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -47, 0.5, -9.5),
        Size = UDim2.fromOffset(32, 19),
    }, f)
    round(track, 19)
    local knob = make("Frame", {
        Name = "Knob",
        BackgroundColor3 = Color3.fromRGB(249, 232, 235),
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(13, 14),
    }, track)
    round(knob, 13)
    knob:SetAttribute("ToggleKnob", true)
    knob:SetAttribute("FixedColor", true)
    c.value = opt(config, "Value", false) == true
    local function paint(smooth)
        if smooth then
            animate(w, track, {
                BackgroundColor3 = c.value and w.accent or C.Track,
