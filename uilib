local function asset(id)
    id = tostring(id)
    return id:match("^%d+$") and "rbxassetid://" .. id or id
end

local iconOffsets = {
    swords = Vector2.new(4, 4),
    crosshair = Vector2.new(36, 4),
    wrench = Vector2.new(68, 4),
    settings = Vector2.new(100, 4),
    user = Vector2.new(4, 36),
    house = Vector2.new(36, 36),
    eye = Vector2.new(68, 36),
    minus = Vector2.new(100, 36),
    x = Vector2.new(4, 68),
}

local function addIcon(parent, name, position, size)
    local value = tostring(name)
    local offset = iconOffsets[string.lower(value)]
    local standaloneImage = value:match("%d+") == "125304603079291"
            and "rbxassetid://98729914829489"
        or asset(value)
    assert(
        offset or value:match("^%d+$") or value:match("^rbxassetid://%d+$"),
        "Unknown icon: " .. value
    )
    return make("ImageLabel", {
        Name = "Icon",
        BackgroundTransparency = 1,
        Image = offset and "rbxassetid://134425129651297" or standaloneImage,
        ImageRectOffset = offset or Vector2.zero,
        ImageRectSize = offset and Vector2.new(24, 24) or Vector2.zero,
        ImageColor3 = C.Muted,
        Size = UDim2.fromOffset(size or 16, size or 16),
        Position = position,
        ZIndex = parent.ZIndex,
    }, parent)
end

local function side(value)
    value = string.lower(value or "left")
    assert(value == "left" or value == "right", "Side must be left or right")
    return value
end

local function listen(owner, signal, callback)
    local c = signal:Connect(callback)
    table.insert(owner.connections, c)
    return c
end

local function disconnect(owner)
    for _, c in ipairs(owner.connections) do
        c:Disconnect()
    end
    table.clear(owner.connections)
end

local function toggleKnobColor(accent, enabled)
    local brightness = accent.R * 0.2126 + accent.G * 0.7152 + accent.B * 0.0722
    if enabled and brightness > 0.72 then
        return Color3.fromRGB(48, 51, 58)
    end
    return Color3.fromRGB(249, 232, 235)
end

local function styleBrand(title, accent, connect)
    if not title or title.Text:gsub("<.->", ""):lower() ~= "daxware" then
        return nil
    end
    title.RichText = true
    local color = title:FindFirstChild("BrandAccent") or Instance.new("Color3Value")
    color.Name = "BrandAccent"
    color.Value = accent
    color.Parent = title
    local function redraw()
        title.Text = 'dax<font color="#' .. color.Value:ToHex() .. '">ware</font>'
    end
    connect(color.Changed, redraw)
    redraw()
    return color
end

local function animateTopbar(button, icon, name, ctx)
    if not button or not icon then
        return
    end
    local size = icon.Size
    local position = icon.Position
    icon.Position = UDim2.new(
        position.X.Scale,
        position.X.Offset + size.X.Offset * (0.5 - icon.AnchorPoint.X),
        position.Y.Scale,
        position.Y.Offset + size.Y.Offset * (0.5 - icon.AnchorPoint.Y)
    )
    icon.AnchorPoint = Vector2.new(0.5, 0.5)
    local scale = Instance.new("UIScale")
    scale.Name = "HoverScale"
    scale.Parent = icon
    local hovered = false
    local token = 0
    local function paint()
        ctx.tween(scale, { Scale = hovered and 1.12 or 1 }, 0.16)
        ctx.tween(icon, {
            Rotation = hovered and (name == "settings" and 35 or name == "close" and 90 or 0) or 0,
            ImageColor3 = hovered and ctx.accent() or Color3.fromRGB(171, 173, 182),
        }, 0.18)
    end
    ctx.connect(button.MouseEnter, function()
        hovered = true
        paint()
    end)
    ctx.connect(button.MouseLeave, function()
        hovered = false
        paint()
    end)
    ctx.connect(button.InputBegan, function(input)
        if
            input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            token += 1
            local current = token
            ctx.tween(scale, { Scale = 0.88 }, 0.08)
            task.delay(0.1, function()
                if icon.Parent and current == token then
                    paint()
                end
            end)
        end
    end)
end

local function themeProperties(object)
    local properties = {}
    if object:IsA("GuiObject") then
        properties = { "BackgroundColor3" }
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            table.insert(properties, "TextColor3")
        end
        if object:IsA("ImageLabel") or object:IsA("ImageButton") then
            table.insert(properties, "ImageColor3")
        end
        if object:IsA("ScrollingFrame") then
            table.insert(properties, "ScrollBarImageColor3")
        end
    elseif object:IsA("UIStroke") then
        properties = { "Color" }
    end
    return properties
end

local function fixedColor(object)
    return object:FindFirstAncestor("Swatches") ~= nil or object:GetAttribute("FixedColor") == true
end

local function captureAccent(bindings, seen, root, color)
    for _, object in ipairs(root:GetDescendants()) do
        if not seen[object] then
            seen[object] = true
            if not fixedColor(object) then
                for _, property in ipairs(themeProperties(object)) do
                    if object[property] == color then
                        bindings[object] = bindings[object] or {}
                        bindings[object][property] = true
                    end
                end
            end
        end
    end
end

local function trackAccent(bindings, object, property, value, color)
    if typeof(value) ~= "Color3" or fixedColor(object) then
        return
    end
    local properties = bindings[object]
    if value == color then
        if not properties then
            properties = {}
            bindings[object] = properties
        end
        properties[property] = true
    elseif properties then
        properties[property] = nil
    end
end

local function animate(w, object, props, duration, style, direction)
    if w.destroyed or not object.Parent then
        return
    end
    local channels = w.tweens[object]
    if not channels then
        channels = {}
        w.tweens[object] = channels
    end
    for property, value in pairs(props) do
        trackAccent(w.accentBindings, object, property, value, w.accent)
        if channels[property] then
            channels[property]:Cancel()
        end
        local t = TweenService:Create(
            object,
            TweenInfo.new(
                duration or 0.16,
                style or Enum.EasingStyle.Quad,
                direction or Enum.EasingDirection.Out
            ),
            {
                [property] = value,
            }
        )
        channels[property] = t
        t:Play()
    end
end

local function cancel(w, object)
    local channels = w.tweens[object]
    if channels then
        for _, t in pairs(channels) do
            t:Cancel()
        end
    end
    w.tweens[object] = nil
end

local function call(w, callback, value)
    if callback and not w.destroyed then
        task.spawn(function()
            local ok, err = pcall(callback, value)
            if not ok then
                warn("[daxware] Callback:", err)
            end
        end)
    end
end

local function elementSide(self, value)
    if self.destroyed then
        return
    end
    self.side = side(value)
    self.frame.Parent = self.tab.columns[self.side]
    if self.tab._Arrange then
        self.tab:_Arrange()
    end
end

