        if not page.Visible then
            return
        end
        for _, card in ipairs(scroll:GetChildren()) do
            if card:IsA("CanvasGroup") then
                card.GroupTransparency = 1
                task.delay((card.LayoutOrder - 1) * 0.045, function()
                    if card.Parent and page.Visible and token == entranceToken then
                        ctx.tween(card, { GroupTransparency = 0 }, 0.22)
                    end
                end)
            end
        end
    end)
    ctx.connect(ctx.root:GetAttributeChangedSignal("SettingsRevision"), function()
