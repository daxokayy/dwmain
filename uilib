    p.nameLabel.AnchorPoint = Vector2.new(0.5, 1)
    p.nameLabel.Font = Enum.Font.ArialBold
    p.nameLabel.TextXAlignment = Enum.TextXAlignment.Center
    p.nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    p.nameLabel.TextStrokeTransparency = 0
    p.highlight = make("ImageLabel", {
        Name = "CharacterHighlight",
        Image = p.humanoid.Image,
        BackgroundTransparency = 1,
        AnchorPoint = p.humanoid.AnchorPoint,
        Size = p.humanoid.Size,
        ScaleType = Enum.ScaleType.Fit,
        ImageTransparency = 0.55,
    }, p.frame)
    local dragging, start, original
    local draggable = opt(config, "Draggable", p.mode == "aim")
    listen(p, p.humanoid.InputBegan, function(input)
        if
            draggable
            and (
                input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch
            )
        then
            dragging = input
            start = Vector2.new(input.Position.X, input.Position.Y)
            original = p.goal
        end
    end)
    listen(p, UIS.InputChanged, function(input)
        if not dragging or w.selected ~= self or not w.visible or w.minimized then
            return
        end
        if
            input == dragging
            or (
                dragging.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseMovement
            )
        then
            local size = p.frame.AbsoluteSize
            if size.X <= 0 or size.Y <= 0 then
                return
            end
            local d = Vector2.new(input.Position.X, input.Position.Y) - start
            local point = original + Vector2.new(d.X / size.X, d.Y / size.Y)
            local width = p.humanoid.AbsoluteSize.X / 2 / size.X
            local top = p.humanoid.AbsoluteSize.Y * 0.44 / size.Y
            local bottom = p.humanoid.AbsoluteSize.Y * 0.56 / size.Y
            p.goal = Vector2.new(
                math.clamp(point.X, math.min(width, 0.49), math.max(1 - width, 0.51)),
                math.clamp(point.Y, math.min(top, 0.49), math.max(1 - bottom, 0.51))
            )
        end
    end)
    listen(p, UIS.InputEnded, function(input)
        if input == dragging then
            dragging = nil
        end
    end)
    listen(p, UIS.WindowFocusReleased, function()
        dragging = nil
    end)
    if p.mode == "esp" and opt(config, "CycleRoles", true) then
        listen(p, p.humanoid.Activated, function()
            p:SetRole(p.role == "Sheriff" and "Murderer" or "Sheriff")
        end)
        local hint = label(
            p.frame,
            "Hint",
            "Click character to switch role",
            10,
            UDim2.new(0, 0, 1, -25),
            UDim2.new(1, 0, 0, 20),
            C.Subtle
        )
        hint.TextXAlignment = Enum.TextXAlignment.Center
    end
    listen(p, p.frame:GetPropertyChangedSignal("AbsoluteSize"), function()
        p:_Draw()
    end)
    w.ticks[p] = function(alpha)
        local dirty = false
        if (p.goal - p.target).Magnitude > 0.00001 then
            p.target = p.target:Lerp(p.goal, alpha)
            dirty = true
        end
        if math.abs(p.fov - p.displayFov) > 0.001 then
            p.displayFov += (p.fov - p.displayFov) * alpha
            dirty = true
        end
        if dirty then
            p:_Draw()
        end
    end
    grid.ZIndex = 1
    p.humanoid.ZIndex = 2
    p.highlight.ZIndex = 3
    p.circle.ZIndex = 4
    p.line.ZIndex = 5
    p.center.ZIndex = 6
    p.dot.ZIndex = 6
    p.box.ZIndex = 7
    p.nameLabel.ZIndex = 8

    p:_Style(false)
    table.insert(self.elements, p)
    self:_Arrange()
    task.defer(function()
        if not p.destroyed then
            p:_Draw()
        end
    end)
    return p
end

function Preview:_Draw()
    if self.destroyed or self.window.destroyed then
        return
    end
    local size = self.frame.AbsoluteSize / math.max(self.window.scale.Scale, 0.001)
    if size.X <= 0 or size.Y <= 0 then
        return
    end
    local radius = math.clamp(
        size.X * 0.351 * (self.displayFov or self.fov) / 250,
        12,
        math.min(size.X, size.Y) * 0.48
    )
    self.circle.Size = UDim2.fromOffset(radius * 2, radius * 2)
    self.humanoid.Position = UDim2.fromScale(self.target.X, self.target.Y)
    self.highlight.Position = self.humanoid.Position
    local origin = Vector2.new(size.X * 0.5, size.Y * 0.505)
    local target = Vector2.new(size.X * self.target.X, size.Y * self.target.Y)
    local delta = target - origin
    self.inside = delta.Magnitude <= radius
    self.frame:SetAttribute("TargetInsideCircle", self.inside)
    local aim = self.mode == "aim"
    self.circle.Visible = aim and self.circleVisible
    self.center.Visible = aim
    self.line.Visible = aim and self.lineVisible and self.inside
    self.dot.Visible = self.line.Visible
    self.dot.Position = self.humanoid.Position
    self.line.Position = UDim2.fromOffset((origin.X + target.X) / 2, (origin.Y + target.Y) / 2)
    self.line.Size = UDim2.fromOffset(delta.Magnitude, 1)
    self.line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    local hs = self.humanoid.Size
    self.box.Position =
        UDim2.fromOffset(target.X - hs.X.Offset / 2 - 10, target.Y - hs.Y.Offset * 0.44 - 3)
    self.box.Size = UDim2.fromOffset(hs.X.Offset + 20, hs.Y.Offset + 7)
    self.nameLabel.Position = UDim2.fromOffset(target.X, self.box.Position.Y.Offset - 3)
end

function Preview:_Style(smooth)
    if self.destroyed or self.window.destroyed then
        return
    end
    local esp = self.mode == "esp"
    self.box.Visible = esp
    self.nameLabel.Visible = esp
    self.highlight.Visible = esp
    if not esp then
        return
    end
    local color = roleColors[self.role] or C.Muted
    self.nameLabel.Text = self.playerName .. " [" .. self.role .. "]"
    local boxProperties = {
        Color = color,
        Transparency = self.espEnabled and 0 or 1,
    }
    local showName = self.espEnabled and self.namesVisible
    local textProperties = {
        TextColor3 = color,
        TextTransparency = showName and 0 or 1,
        TextStrokeTransparency = showName and 0 or 1,
    }
    local imageProperties = {
        ImageColor3 = color,
        ImageTransparency = self.espEnabled and self.highlightVisible and 0.55 or 1,
    }
    if smooth then
        animate(self.window, self.boxStroke, boxProperties, 0.16)
        animate(self.window, self.nameLabel, textProperties, 0.16)
        animate(self.window, self.highlight, imageProperties, 0.16)
    else
        for k, v in pairs(boxProperties) do
            self.boxStroke[k] = v
        end
        for k, v in pairs(textProperties) do
            self.nameLabel[k] = v
        end
        for k, v in pairs(imageProperties) do
            self.highlight[k] = v
        end
    end
end

function Preview:SetTarget(value)
    if self.destroyed then
