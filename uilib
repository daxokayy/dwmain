            keyButton.Text = ctx.key().Name
        end
        hex.Text = "#" .. ctx.accent():ToHex():upper()
        scroll.ScrollBarImageColor3 = ctx.accent()
        showScale(ctx.scale())
        for swatch, stroke in pairs(selections) do
            ctx.tween(
                stroke,
                { Transparency = swatch.Name:lower() == ctx.accent():ToHex():lower() and 0 or 1 },
                0.15
            )
        end
    end)
    return page
end

function UI:CreateWindow(config)
    config = config or {}
    local size = opt(config, "Size", Vector2.new(700, 499))
    assert(
        typeof(size) == "Vector2" and size.X >= 400 and size.Y >= 300,
        "Size must be a Vector2 at least 400 x 300"
    )
    local w = setmetatable({
        connections = {},
        accentBindings = setmetatable({}, { __mode = "k" }),
        accentSeen = setmetatable({}, { __mode = "k" }),
        tweens = setmetatable({}, {
            __mode = "k",
        }),
        ticks = {},
        tabs = {},
        destroyed = false,
        unloaded = false,
        accent = opt(config, "Accent", C.Accent),
        size = size,
        visible = true,
        minimized = false,
        ready = false,
        token = 0,
        toggleKey = opt(config, "ToggleKey", Enum.KeyCode.RightControl),
        config = config,
    }, Window)
    settingsState[w] = {}
    w.gui = make("ScreenGui", {
        Name = opt(config, "Name", "daxwareUI"),
        ResetOnSpawn = false,
        DisplayOrder = opt(config, "DisplayOrder", 100),
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = opt(config, "IgnoreGuiInset", true),
    }, opt(config, "Parent", nil) or Players.LocalPlayer:WaitForChild("PlayerGui"))
    w.root = make("CanvasGroup", {
        Name = "Window",
        BackgroundColor3 = C.Background,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0),
        Position = opt(config, "Position", UDim2.fromScale(0.5, 0.5)),
