            animate(w, knob, {
                Position = UDim2.fromOffset(c.value and 17 or 3, 3),
                BackgroundColor3 = toggleKnobColor(w.accent, c.value),
            })
        else
            track.BackgroundColor3 = c.value and w.accent or C.Track
            knob.Position = UDim2.fromOffset(c.value and 17 or 3, 3)
            knob.BackgroundColor3 = toggleKnobColor(w.accent, c.value)
        end
    end
    function c:Get()
        return self.value
    end
    function c:Set(value, silent)
        if self.destroyed then
            return
        end
        value = value == true
        local changed = self.value ~= value
        self.value = value
        self.frame:SetAttribute("Value", value)
        paint(true)
        if changed and not silent then
            call(w, self.callback, value)
        end
    end
    listen(c, c.hit.Activated, function()
        if c.enabled then
            c:Set(not c.value)
        end
    end)
    f:SetAttribute("Value", c.value)
    paint(false)
    c:SetEnabled(c.enabled)
    return c
end

function Group:AddSlider(config)
    config = config or {}
    local w = self.window
    local min, max, step = opt(config, "Min", 0), opt(config, "Max", 100), opt(config, "Step", 1)
    assert(max > min and step > 0, "Slider requires Max > Min and Step > 0")
    local f = row(self, "Slider", 52.5)
    local c = control(self, f, config)
    c.label = label(
        f,
        "Label",
        opt(config, "Name", "Slider"),
        15,
        UDim2.fromOffset(13, 3),
        UDim2.new(1, -110, 0, 23)
    )
    local number =
        label(f, "ValueLabel", "", 15, UDim2.new(1, -100, 0, 3), UDim2.fromOffset(85, 23), C.Muted)
    number.TextXAlignment = Enum.TextXAlignment.Right
    local track = make("Frame", {
        Name = "Track",
        BackgroundColor3 = C.Track,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(14, 38),
        Size = UDim2.new(1, -29, 0, 4),
    }, f)
    round(track, 4)
    local fill = make("Frame", {
        Name = "Fill",
        BackgroundColor3 = w.accent,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(0, 1),
    }, track)
    round(fill, 4)
    local knob = make("Frame", {
        Name = "Knob",
        BackgroundColor3 = w.accent,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(12, 12),
    }, track)
    round(knob, 12)
    c.hit = hit(f, "Hit", UDim2.fromOffset(7, 27), UDim2.new(1, -14, 0, 25))
    local active
    local decimals = 0
    while
        decimals < 6
        and math.abs(step * 10 ^ decimals - math.round(step * 10 ^ decimals)) > 0.000001
    do
        decimals += 1
    end
    function c:Get()
        return self.value
    end
    function c:Set(value, silent)
        if self.destroyed then
            return
        end
        assert(type(value) == "number" and value == value, "Slider value must be a number")
        value = math.clamp(min + math.round((value - min) / step) * step, min, max)
        local changed = self.value ~= value
        self.value = value
        self.goal = (value - min) / (max - min)
        f:SetAttribute("Value", value)
        number.Text = string.format("%." .. decimals .. "f", value) .. opt(config, "Suffix", "")
        if changed and not silent then
            call(w, self.callback, value)
        end
    end
    c:Set(opt(config, "Value", min), true)
    c.display = c.goal
    fill.Size = UDim2.fromScale(c.display, 1)
    knob.Position = UDim2.fromScale(c.display, 0.5)
    local function update(input)
        if not c.enabled or track.AbsoluteSize.X <= 0 then
            return
        end
        c:Set(
            min
                + math.clamp(
                        (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X,
                        0,
                        1
                    )
                    * (max - min)
        )
    end
    listen(c, c.hit.InputBegan, function(input)
        if
            c.enabled
            and (
                input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch
            )
        then
            active = input
            update(input)
        end
    end)
    listen(c, UIS.InputChanged, function(input)
        if
            active
            and w.visible
            and w.selected == self.tab
            and (
                input == active
                or (
                    active.UserInputType == Enum.UserInputType.MouseButton1
                    and input.UserInputType == Enum.UserInputType.MouseMovement
                )
            )
        then
            update(input)
        end
    end)
    listen(c, UIS.InputEnded, function(input)
        if input == active then
            active = nil
        end
    end)
    listen(c, UIS.WindowFocusReleased, function()
        active = nil
    end)
    w.ticks[c] = function(alpha)
        if math.abs(c.goal - c.display) > 0.00001 then
            c.display += (c.goal - c.display) * alpha
            fill.Size = UDim2.fromScale(c.display, 1)
            knob.Position = UDim2.fromScale(c.display, 0.5)
        end
    end
    c:SetEnabled(c.enabled)
    return c
end

function Group:AddButton(config)
    config = config or {}
    local w = self.window
    local f = row(self, "Button", 34)
    local c = control(self, f, config)
    c.hit = hit(f, "Hit")
    c.hit.BackgroundColor3 = Color3.fromRGB(47, 33, 40)
    round(c.hit, 5)
    c.label = label(
        c.hit,
        "Label",
        opt(config, "Name", opt(config, "Text", "Button")),
        15,
        UDim2.fromOffset(13, 0),
        UDim2.new(1, -26, 1, 0)
    )
    local iconName = opt(config, "Icon", nil)
    if iconName then
        local iconSize = math.clamp(opt(config, "IconSize", 20), 12, 28)
        c.icon = addIcon(c.hit, iconName, UDim2.new(0, 9, 0.5, -iconSize / 2), iconSize)
        c.label.Position = UDim2.fromOffset(17 + iconSize, 0)
        c.label.Size = UDim2.new(1, -30 - iconSize, 1, 0)
        c.icon:SetAttribute("FixedColor", true)
        c.icon.AnchorPoint = Vector2.new(0.5, 0.5)
        c.icon.Position = UDim2.new(0, 9 + iconSize / 2, 0.5, 0)
        c.iconScale = make("UIScale", { Scale = 1 }, c.icon)
        local function matchText()
            c.icon.ImageColor3 = c.label.TextColor3
            c.icon.ImageTransparency = c.label.TextTransparency
        end
        matchText()
        listen(c, c.label:GetPropertyChangedSignal("TextColor3"), matchText)
        listen(c, c.label:GetPropertyChangedSignal("TextTransparency"), matchText)
    end
    local hovered = false
    c.busy = false
    local function paint(pressed)
        animate(w, c.hit, {
            BackgroundTransparency = c.enabled and (pressed and 0.1 or hovered and 0.55 or 1) or 1,
        }, 0.13)
    end
    listen(c, c.hit.MouseEnter, function()
        hovered = true
        paint(false)
    end)
    listen(c, c.hit.MouseLeave, function()
        hovered = false
        paint(false)
    end)
    listen(c, c.hit.InputBegan, function(input)
        if
            c.enabled
            and (
                input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch
            )
        then
            paint(true)
        end
    end)
    listen(c, c.hit.Activated, function()
        if c.enabled and c.icon then
            c.iconToken = (c.iconToken or 0) + 1
            local token = c.iconToken
            animate(w, c.iconScale, { Scale = 0.78 }, 0.08)
            animate(w, c.icon, { Rotation = -14 }, 0.08)
            task.delay(0.08, function()
                if not c.destroyed and c.icon.Parent and token == c.iconToken then
                    animate(w, c.iconScale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
                    animate(w, c.icon, { Rotation = 0 }, 0.25, Enum.EasingStyle.Back)
                end
            end)
        end
        if not c.enabled or c.busy then
            return
        end
        c.busy = true
        paint(true)
        task.spawn(function()
            local ok, err = pcall(function()
                if c.callback then
                    c.callback(c)
                end
            end)
            c.busy = false
            if not ok then
                warn("[daxware] Button:", err)
            end
            if not c.destroyed then
                paint(false)
            end
        end)
    end)
    c:SetEnabled(c.enabled)
    return c
end

