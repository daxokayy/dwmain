local function opt(c, key, fallback)
    local value = c[key]
    if value == nil then
        value = c[key:sub(1, 1):lower() .. key:sub(2)]
    end
    if value == nil then
        return fallback
    end
    return value
end

local function make(class, props, parent)
    local v = Instance.new(class)
    for k, x in pairs(props) do
        v[k] = x
    end
    v.Parent = parent
    return v
end

local function round(v, n)
    make("UICorner", {
        CornerRadius = UDim.new(0, n or 6),
    }, v)
end

local function border(v, color, width)
