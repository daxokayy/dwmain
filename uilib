function Group:Destroy()
    if self.destroyed then
        return
    end
    self.destroyed = true
    disconnect(self)
    for _, control in ipairs(self.controls) do
        control:Destroy()
    end
    self.frame:Destroy()
    if not self.tab.destroyed then
        self.tab:_Arrange()
    end
end

local function row(group, name, height)
    assert(not group.destroyed, "Group is destroyed")
    local count = #group.controls + 1
    local f = make("Frame", {
        Name = name,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = count,
    }, group.frame)
    if count > 1 then
        make("Frame", {
            Name = "Divider",
            BackgroundColor3 = C.Border,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(13, 0),
            Size = UDim2.new(1, -28, 0, 1),
        }, f)
    end
    return f
end

local function control(group, frame, config)
    local c = {
        window = group.window,
        connections = {},
        frame = frame,
        Instance = frame,
        destroyed = false,
        enabled = opt(config, "Enabled", true),
    }
    function c:Destroy()
        if self.destroyed then
            return
        end
        self.destroyed = true
        disconnect(self)
        self.window.ticks[self] = nil
        for _, v in ipairs(self.frame:GetDescendants()) do
            cancel(self.window, v)
        end
        self.frame:Destroy()
    end
    function c:SetText(value)
        if not self.destroyed then
            self.label.Text = tostring(value)
        end
    end
    function c:SetCallback(callback)
        assert(callback == nil or type(callback) == "function", "Callback must be a function")
        self.callback = callback
    end
    function c:SetEnabled(value)
        if self.destroyed then
            return
        end
        self.enabled = value == true
        self.label.TextTransparency = self.enabled and 0 or 0.55
        if self.hit then
            self.hit.Active = self.enabled
            self.hit.Selectable = self.enabled
        end
    end
    c.callback = opt(config, "Callback", nil)
    table.insert(group.controls, c)
    return c
end

