    self.tab:_Arrange()
    self:_Draw()
end

function Preview:Destroy()
    if self.destroyed then
        return
    end
    self.destroyed = true
    disconnect(self)
    self.window.ticks[self] = nil
    for _, v in self.frame:GetDescendants() do
        cancel(self.window, v)
    end
    self.frame:Destroy()
    if not self.tab.destroyed then
        self.tab:_Arrange()
    end
end

function Window:_Load()
    if self.destroyed then
        return
    end
    local l = make("CanvasGroup", {
        Name = "Loader",
        BackgroundColor3 = C.Background,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(389, 215),
        GroupColor3 = Color3.new(1, 1, 1),
    }, self.gui)
    round(l, 8)
    local outline = border(l)
    local scale = make("UIScale", {
        Scale = 0.97,
    }, l)
    label(
        l,
        "Title",
        opt(self.config, "Title", "daxware"),
        20,
        UDim2.fromOffset(18, 9),
        UDim2.fromOffset(250, 26),
        C.Text,
        true
    )
    local spinner = make("ImageLabel", {
        Name = "Spinner",
        Image = asset(opt(self.config, "SpinnerImage", "111673319252699")),
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0, 77),
        Size = UDim2.fromOffset(54, 54),
        ScaleType = Enum.ScaleType.Fit,
    }, l)
    local loading = label(
        l,
        "LoadingText",
        "Loading...",
        22,
        UDim2.fromOffset(0, 110),
        UDim2.fromOffset(389, 30),
        C.Text,
        true
    )
    loading.TextXAlignment = Enum.TextXAlignment.Center
    local subtitle = label(
        l,
        "Subtitle",
        "Getting things ready",
        13,
        UDim2.fromOffset(0, 142),
        UDim2.fromOffset(389, 22),
        C.Subtle
    )
    subtitle.TextXAlignment = Enum.TextXAlignment.Center
    local track = make("Frame", {
        Name = "Track",
        BackgroundColor3 = C.Track,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(18, 181),
        Size = UDim2.fromOffset(309, 7),
    }, l)
    round(track, 7)
    local fill = make("Frame", {
        Name = "Fill",
        BackgroundColor3 = self.accent,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(0, 1),
    }, track)
    round(fill, 7)
    local percent = label(
        l,
        "Percentage",
        "0%",
        13,
        UDim2.fromOffset(333, 171),
        UDim2.fromOffset(40, 27),
        C.Muted
    )
    percent.TextXAlignment = Enum.TextXAlignment.Center
    local progress, goal = 0, 0
    local started = os.clock()
    self.loader = l
    self.ticks[l] = function(alpha, dt)
        spinner.Rotation = (spinner.Rotation + 210 * dt) % 360
        progress += (goal - progress) * alpha
        fill.Size = UDim2.fromScale(progress, 1)
        percent.Text = math.floor(progress * 100 + 0.5) .. "%"
    end
    animate(self, scale, {
        Scale = 1,
    }, 0.22)
    local function waitFor(predicate, timeout)
        local deadline = os.clock() + timeout
        while not self.destroyed and not predicate() and os.clock() < deadline do
            task.wait(0.05)
        end
        return not self.destroyed and predicate()
    end
    waitFor(function()
        return game:IsLoaded()
    end, 20)
    if self.destroyed then
        return
    end
    goal = 0.3
    subtitle.Text = "Loading preview assets"
    local assets, seen = {}, {}
    for _, v in self.gui:GetDescendants() do
        if
            (v:IsA("ImageLabel") or v:IsA("ImageButton"))
            and v.Image ~= ""
            and not seen[v.Image]
        then
            seen[v.Image] = true
            table.insert(assets, v.Image)
        end
    end
    local done = false
    local completed = 0
    local failures = 0
    task.spawn(function()
        local ok = pcall(function()
            ContentProvider:PreloadAsync(assets, function(_, status)
                completed += 1
                if status ~= Enum.AssetFetchStatus.Success then
                    failures += 1
                end
                goal = math.max(goal, 0.3 + 0.65 * completed / math.max(#assets, 1))
            end)
        end)
        if not ok then
            failures += 1
        end
        done = true
    end)
    waitFor(function()
        return done
    end, 12)
    if self.destroyed then
        return
    end
    subtitle.Text = "Almost ready"
    goal = 0.95
    waitFor(function()
        return os.clock() - started >= opt(self.config, "LoadingDuration", 2.2)
    end, math.max(1, opt(self.config, "LoadingDuration", 2.2) + 1))
    goal = 1
    loading.Text = "Ready"
    subtitle.Text = "Ready"
    waitFor(function()
        return progress > 0.998
    end, 1)
    if self.destroyed then
        return
    end
    fill.Size = UDim2.fromScale(1, 1)
    percent.Text = "100%"
    task.wait(0.15)
    if self.destroyed then
        return
    end
    l:SetAttribute("State", "Complete")
    l:SetAttribute("AssetFailures", failures)
    self.ready = true
    self.root.Visible = true
    self.scale.Scale = self.fit * 0.96
    self:SetVisible(true)
    animate(self, l, {
        GroupTransparency = 1,
    }, 0.28)
    animate(self, outline, {
        Transparency = 1,
    }, 0.28)
    animate(self, scale, {
        Scale = 0.97,
    }, 0.28)
    task.delay(0.3, function()
        if not self.destroyed then
            self.ticks[l] = nil
            l.Visible = false
        end
    end)
    call(self, opt(self.config, "OnLoaded", nil), self)
end

function Tab:AddContent(config)
    assert(not self.destroyed, "Tab is destroyed")
    config = config or {}
    local frame = opt(config, "Instance", nil)
    assert(
        typeof(frame) == "Instance" and frame:IsA("GuiObject"),
        "AddContent requires a GuiObject in Instance"
    )
    if opt(config, "Clone", false) then
        frame = frame:Clone()
    end
    local item = {
        tab = self,
        window = self.window,
        connections = {},
        frame = frame,
        side = side(opt(config, "Side", "left")),
        destroyed = false,
        kind = "custom",
    }
    frame.LayoutOrder = opt(config, "Order", #self.elements + 1)
    frame.Parent = self.columns[item.side]
    if opt(config, "FitWidth", true) then
        frame.Size = UDim2.new(1, -2, frame.Size.Y.Scale, frame.Size.Y.Offset)
    end
    item.SetSide = elementSide
    function item:Destroy()
        if self.destroyed then
            return
        end
        self.destroyed = true
        self.frame:Destroy()
        if not self.tab.destroyed then
            self.tab:_Arrange()
        end
    end
    table.insert(self.elements, item)
    self:_Arrange()
    return item
end

