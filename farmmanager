function Tab:Destroy()
    if self.destroyed then
        return
    end
    self.destroyed = true
    disconnect(self)
    for _, item in ipairs(self.elements) do
        item:Destroy()
    end
    cancel(self.window, self.page)
    cancel(self.window, self.button)
    cancel(self.window, self.underline)
    self.page:Destroy()
    self.button:Destroy()
    if self.window.selected == self then
        self.window.selected = nil
        if not self.window.destroyed then
            for _, tab in ipairs(self.window.tabs) do
                if not tab.destroyed then
                    self.window:SelectTab(tab)
                    break
                end
            end
        end
    end
end

