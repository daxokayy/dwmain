        BorderSizePixel = 0,
        Size = UDim2.fromScale(0.5, 1),
    }, track)
    corner(fill)
    local knob = create("Frame", {
        Name = "Knob",
        BackgroundColor3 = ctx.accent(),
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(12, 12),
        Position = UDim2.fromScale(0.5, 0.5),
    }, track)
    corner(knob)
    local hit = create("TextButton", {
        Name = "Hit",
        Text = "",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(-8, -12),
        Size = UDim2.new(1, 16, 0, 28),
    }, track)
    local function showScale(value)
        local ratio = (value - 0.65) / 0.6
        percent.Text = string.format("%d%%", math.round(value * 100))
        ctx.tween(fill, { Size = UDim2.fromScale(ratio, 1) }, 0.1)
        ctx.tween(knob, { Position = UDim2.fromScale(ratio, 0.5) }, 0.1)
    end
    ctx.connect(hit.MouseEnter, function()
        ctx.tween(knob, { Size = UDim2.fromOffset(16, 16) }, 0.14)
    end)
    ctx.connect(hit.MouseLeave, function()
        ctx.tween(knob, { Size = UDim2.fromOffset(12, 12) }, 0.14)
    end)
    showScale(ctx.scale())
    local dragging
    local function updateScale(input)
        local ratio = math.clamp(
            (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1),
            0,
            1
        )
        local value = math.round((0.65 + ratio * 0.6) * 100) / 100
        ctx.setScale(value)
        showScale(value)
    end
    ctx.connect(hit.InputBegan, function(input)
        if
            input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            dragging = input
            updateScale(input)
        end
    end)
    ctx.connect(game:GetService("UserInputService").InputChanged, function(input)
        if
            dragging
            and (
                input == dragging
                or input.UserInputType == Enum.UserInputType.MouseMovement
                    and dragging.UserInputType == Enum.UserInputType.MouseButton1
            )
        then
            updateScale(input)
        end
    end)
    ctx.connect(game:GetService("UserInputService").InputEnded, function(input)
        if input == dragging then
            dragging = nil
        end
    end)
    ctx.connect(game:GetService("UserInputService").WindowFocusReleased, function()
        dragging = nil
    end)
    local entranceToken = 0
    ctx.connect(page:GetPropertyChangedSignal("Visible"), function()
        entranceToken += 1
        local token = entranceToken
        if not page.Visible then
            return
        end
        for _, card in ipairs(scroll:GetChildren()) do
            if card:IsA("CanvasGroup") then
                card.GroupTransparency = 1
                task.delay((card.LayoutOrder - 1) * 0.045, function()
                    if card.Parent and page.Visible and token == entranceToken then
                        ctx.tween(card, { GroupTransparency = 0 }, 0.22)
                    end
                end)
            end
        end
    end)
    ctx.connect(ctx.root:GetAttributeChangedSignal("SettingsRevision"), function()
        if not ctx.root:GetAttribute("CapturingKey") then
            keyButton.Text = ctx.key().Name
        end
        hex.Text = "#" .. ctx.accent():ToHex():upper()
        scroll.ScrollBarImageColor3 = ctx.accent()
        showScale(ctx.scale())
        for swatch, stroke in pairs(selections) do
            ctx.tween(
                stroke,
                { Transparency = swatch.Name:lower() == ctx.accent():ToHex():lower() and 0 or 1 },
                0.15
            )
        end
    end)
    return page
end

