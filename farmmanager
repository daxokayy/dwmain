function Tab:_Arrange()
    local first = {}
    for _, element in ipairs(self.elements) do
        if not element.destroyed and not first[element.side] then
            first[element.side] = element
        end
    end
    local raised
    if
        first.left
        and first.left.kind == "preview"
        and (not first.right or first.right.kind ~= "preview")
    then
        raised = "left"
    elseif
        first.right
        and first.right.kind == "preview"
        and (not first.left or first.left.kind ~= "preview")
    then
        raised = "right"
    end
    for which, column in pairs(self.columns) do
        local p = column.Position
        column.Position = UDim2.new(p.X.Scale, p.X.Offset, 0, which == raised and 17 or 76)
        column.Size =
            UDim2.new(column.Size.X.Scale, column.Size.X.Offset, 1, which == raised and -26 or -85)
    end
    local rightTitle = raised == "left"
    self.page.Title.Position = rightTitle and UDim2.new(0.5, 5, 0, 17) or UDim2.fromOffset(19, 17)
    self.page.Description.Position = rightTitle and UDim2.new(0.5, 5, 0, 46)
        or UDim2.fromOffset(19, 46)
    self.page.Title.Size = UDim2.new(0.5, -30, 0, 28)
    self.page.Description.Size = UDim2.new(0.5, -30, 0, 19)
end

