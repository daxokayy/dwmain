function state.restore()
    if not state.active then return end
    state.active = false
    if state.SetAntiAFK then state.SetAntiAFK(false) end
    if state.sheriffShot then state.sheriffShot.Cancel() end
    if state.knifeAction then state.knifeAction.Cancel(); state.knifeAction = nil end
    if state.hostWeaponHooks then state.hostWeaponHooks.Restore() end
    if state.ReleaseClaim then state.ReleaseClaim(true) end
    if state.CloseSocket then state.CloseSocket("Unloaded") end
    if state.farm then state.farm.Stop() end
