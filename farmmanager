    settingsState[w].icon =
        addIcon(settingsState[w].button, "settings", UDim2.new(0.5, -11, 0.5, -11), 22)
    addIcon(mini, "minus", UDim2.new(0.5, -11, 0.5, -11), 22)
    addIcon(close, "x", UDim2.new(0.5, -11, 0.5, -11), 22)
    w.nav = make("ScrollingFrame", {
        Name = "Tabs",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(19, 54),
        Size = UDim2.fromOffset(size.X - 38, 38),
        ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.X,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.X,
    }, w.root)
    make("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, w.nav)
