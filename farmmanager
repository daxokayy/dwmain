        Position = UDim2.new(0, 10, 0.5, -16),
        Size = UDim2.new(1, -20, 0, 32),
    }, f)
    round(field, 5)
    local outline = border(field)
    c.input = make("TextBox", {
        Name = "Input",
        Text = "",
        PlaceholderText = opt(config, "Placeholder", "Enter text..."),
        PlaceholderColor3 = C.Subtle,
        TextColor3 = C.Text,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        MultiLine = false,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(32, 0),
        Size = UDim2.new(1, -41, 1, 0),
    }, field)
    c.hit = c.input
    c.icon = addIcon(field, opt(config, "Icon", 86469743635172), UDim2.new(0, 15, 0.5, 0), 18)
    c.icon.AnchorPoint = Vector2.new(0.5, 0.5)
    c.icon.ImageColor3 = C.Text
    c.icon:SetAttribute("FixedColor", true)
    local iconScale = make("UIScale", { Scale = 1 }, c.icon)
    local maxLength = math.max(1, math.floor(opt(config, "MaxLength", 200)))
    function c:Get()
        return self.value
    end
    function c:Set(value, silent)
        if self.destroyed then
            return
        end
        assert(type(value) == "string", "Textbox value must be a string")
        local length = utf8.len(value)
        if length and length > maxLength then
            value = value:sub(1, utf8.offset(value, maxLength + 1) - 1)
        end
        local changed = self.value ~= value
        self.value = value
        self.input.Text = value
        self.frame:SetAttribute("Value", value)
        if changed and not silent then
            call(w, self.callback, value)
        end
    end
    function c:SetPlaceholder(value)
        if not self.destroyed then
            self.input.PlaceholderText = tostring(value)
        end
    end
    local setEnabled = c.SetEnabled
    function c:SetEnabled(value)
        if self.destroyed then
            return
        end
        setEnabled(self, value)
        self.input.TextEditable = self.enabled
        self.input.TextTransparency = self.enabled and 0 or 0.55
        self.icon.ImageTransparency = self.enabled and 0 or 0.55
        if not self.enabled and self.input:IsFocused() then
            self.input:ReleaseFocus()
        end
    end
    local function pulse()
        c.pulseToken = (c.pulseToken or 0) + 1
        local token = c.pulseToken
        animate(w, iconScale, { Scale = 0.8 }, 0.08)
        task.delay(0.08, function()
            if not c.destroyed and token == c.pulseToken then
                animate(w, iconScale, { Scale = 1 }, 0.23, Enum.EasingStyle.Back)
            end
        end)
    end
    listen(c, c.input.Focused, function()
        if c.enabled then
            animate(w, outline, { Color = w.accent }, 0.15)
        end
    end)
    listen(c, c.input.FocusLost, function(enterPressed)
        if c.destroyed then
            return
        end
        animate(w, outline, { Color = C.Border }, 0.15)
        if c.enabled and enterPressed then
            c:Set(c.input.Text, true)
            call(w, c.callback, c:Get())
            pulse()
        end
    end)
    c:Set(opt(config, "Value", ""), true)
    c:SetEnabled(c.enabled)
    return c
end

