function Group:AddSlider(config)
    config = config or {}
    local w = self.window
    local min, max, step = opt(config, "Min", 0), opt(config, "Max", 100), opt(config, "Step", 1)
    assert(max > min and step > 0, "Slider requires Max > Min and Step > 0")
    local f = row(self, "Slider", 52.5)
    local c = control(self, f, config)
    c.label = label(
        f,
        "Label",
        opt(config, "Name", "Slider"),
        15,
        UDim2.fromOffset(13, 3),
        UDim2.new(1, -110, 0, 23)
    )
    local number =
        label(f, "ValueLabel", "", 15, UDim2.new(1, -100, 0, 3), UDim2.fromOffset(85, 23), C.Muted)
    number.TextXAlignment = Enum.TextXAlignment.Right
    local track = make("Frame", {
        Name = "Track",
        BackgroundColor3 = C.Track,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(14, 38),
        Size = UDim2.new(1, -29, 0, 4),
    }, f)
    round(track, 4)
    local fill = make("Frame", {
        Name = "Fill",
        BackgroundColor3 = w.accent,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(0, 1),
    }, track)
    round(fill, 4)
    local knob = make("Frame", {
        Name = "Knob",
        BackgroundColor3 = w.accent,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(12, 12),
    }, track)
    round(knob, 12)
    c.hit = hit(f, "Hit", UDim2.fromOffset(7, 27), UDim2.new(1, -14, 0, 25))
    local active
    local decimals = 0
    while
        decimals < 6
        and math.abs(step * 10 ^ decimals - math.round(step * 10 ^ decimals)) > 0.000001
    do
        decimals += 1
    end
    function c:Get()
        return self.value
    end
    function c:Set(value, silent)
        if self.destroyed then
            return
        end
        assert(type(value) == "number" and value == value, "Slider value must be a number")
        value = math.clamp(min + math.round((value - min) / step) * step, min, max)
        local changed = self.value ~= value
        self.value = value
        self.goal = (value - min) / (max - min)
        f:SetAttribute("Value", value)
        number.Text = string.format("%." .. decimals .. "f", value) .. opt(config, "Suffix", "")
        if changed and not silent then
            call(w, self.callback, value)
        end
    end
    c:Set(opt(config, "Value", min), true)
    c.display = c.goal
    fill.Size = UDim2.fromScale(c.display, 1)
    knob.Position = UDim2.fromScale(c.display, 0.5)
    local function update(input)
        if not c.enabled or track.AbsoluteSize.X <= 0 then
            return
        end
        c:Set(
            min
                + math.clamp(
                        (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X,
                        0,
                        1
                    )
                    * (max - min)
        )
    end
    listen(c, c.hit.InputBegan, function(input)
        if
            c.enabled
            and (
                input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch
            )
        then
            active = input
            update(input)
        end
    end)
    listen(c, UIS.InputChanged, function(input)
        if
            active
            and w.visible
            and w.selected == self.tab
            and (
                input == active
                or (
                    active.UserInputType == Enum.UserInputType.MouseButton1
                    and input.UserInputType == Enum.UserInputType.MouseMovement
                )
            )
        then
            update(input)
        end
    end)
    listen(c, UIS.InputEnded, function(input)
        if input == active then
            active = nil
        end
    end)
    listen(c, UIS.WindowFocusReleased, function()
        active = nil
    end)
    w.ticks[c] = function(alpha)
        if math.abs(c.goal - c.display) > 0.00001 then
            c.display += (c.goal - c.display) * alpha
            fill.Size = UDim2.fromScale(c.display, 1)
            knob.Position = UDim2.fromScale(c.display, 0.5)
        end
    end
    c:SetEnabled(c.enabled)
    return c
end

function Group:AddDropdown(config)
    config = config or {}
    local w = self.window
    local f = row(self, "Dropdown", 42)
    local c = control(self, f, config)
    local multi = opt(config, "Multi", false) == true
    c.open = false
    c.optionConnections = {}
    c.options = {}
    c.label = label(
        f,
        "Label",
        opt(config, "Name", "Dropdown"),
        14,
        UDim2.fromOffset(13, 0),
        UDim2.new(0.42, -16, 0, 42)
    )
    local selected =
        label(f, "Selected", "", 13, UDim2.new(0.42, 0, 0, 0), UDim2.new(0.58, -43, 0, 42), C.Muted)
    selected.TextXAlignment = Enum.TextXAlignment.Right
    selected.TextTruncate = Enum.TextTruncate.AtEnd
    c.hit = hit(f, "Header", UDim2.new(), UDim2.new(1, 0, 0, 42))
    c.icon = addIcon(c.hit, 136481847167022, UDim2.new(1, -23, 0.5, 0), 18)
    c.icon.AnchorPoint = Vector2.new(0.5, 0.5)
    local optionsFrame = make("ScrollingFrame", {
        Name = "Options",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(10, 42),
        Size = UDim2.new(1, -20, 0, 0),
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = w.accent,
        ClipsDescendants = true,
        Visible = false,
    }, f)
    make(
        "UIListLayout",
        { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) },
        optionsFrame
    )
    local entries = {}
    local function paint()
        selected.Text = multi and (#(c.value or {}) > 0 and table.concat(c.value, ", ") or opt(config, "Placeholder", "Select..."))
            or c.value or opt(config, "Placeholder", "Select...")
        for value, entry in pairs(entries) do
            local active = multi and table.find(c.value or {}, value) ~= nil or (not multi and value == c.value)
            animate(w, entry.label, { TextColor3 = active and w.accent or C.Text }, 0.14)
            animate(w, entry.icon, { ImageTransparency = active and 0 or 1 }, 0.14)
        end
    end
    function c:Get()
        return multi and table.clone(self.value or {}) or self.value
    end
    function c:SetOpen(value)
        if self.destroyed then
            return
        end
        self.open = value == true and self.enabled and #self.options > 0
        self.openToken = (self.openToken or 0) + 1
        local token = self.openToken
        local rows = math.min(#self.options, math.clamp(opt(config, "MaxVisible", 5), 1, 10))
        local height = self.open and rows * 33 - 3 + 8 or 0
        optionsFrame.Visible = true
        animate(w, f, { Size = UDim2.new(1, 0, 0, 42 + height) }, 0.2)
        animate(w, optionsFrame, { Size = UDim2.new(1, -20, 0, math.max(0, height - 5)) }, 0.2)
        animate(w, self.icon, { Rotation = self.open and 180 or 0 }, 0.2)
        task.delay(0.21, function()
            if not self.destroyed and token == self.openToken and not self.open then
                optionsFrame.Visible = false
            end
        end)
    end
    function c:Set(value, silent)
        if self.destroyed then
            return
        end
        if multi then
            assert(type(value) == "table", "Multiselect value must be an array")
            local nextValue, seen = {}, {}
            for _, item in ipairs(value) do
                assert(entries[item], "Dropdown value is not in Options")
                if not seen[item] then seen[item] = true; table.insert(nextValue, item) end
            end
            table.sort(nextValue)
            local changed = table.concat(self.value or {}, "\0") ~= table.concat(nextValue, "\0")
            self.value = nextValue
            self.frame:SetAttribute("SelectionCount", #nextValue)
            paint()
            if changed and not silent then call(w, self.callback, self:Get()) end
        else
            assert(value == nil or entries[value], "Dropdown value is not in Options")
            local changed = self.value ~= value
            self.value = value
            self.frame:SetAttribute("Value", value)
            paint()
            if changed and not silent then call(w, self.callback, value) end
        end
    end
    function c:SetOptions(values, silent)
        if self.destroyed then
            return
        end
        assert(type(values) == "table", "Options must be an array of strings")
        local nextValues, unique = {}, {}
        for _, value in ipairs(values) do
            assert(
                type(value) == "string" and not unique[value],
                "Dropdown options must be unique strings"
            )
            unique[value] = true
            table.insert(nextValues, value)
        end
        for _, connection in ipairs(self.optionConnections) do
            connection:Disconnect()
        end
        table.clear(self.optionConnections)
        for _, entry in pairs(entries) do
            entry.button:Destroy()
        end
        table.clear(entries)
        self.options = nextValues
        for index, value in ipairs(nextValues) do
            local button =
                hit(optionsFrame, "Option" .. index, UDim2.new(), UDim2.new(1, -4, 0, 30))
            button.LayoutOrder = index
            button.BackgroundColor3 = Color3.fromRGB(40, 42, 47)
            round(button, 4)
            local title =
                label(button, "Label", value, 13, UDim2.fromOffset(28, 0), UDim2.new(1, -36, 1, 0))
            title.TextTruncate = Enum.TextTruncate.AtEnd
            local icon = addIcon(button, 86469743635172, UDim2.new(0, 12, 0.5, 0), 14)
            icon.AnchorPoint = Vector2.new(0.5, 0.5)
            entries[value] = { button = button, label = title, icon = icon }
            table.insert(
                self.optionConnections,
                button.Activated:Connect(function()
                    if not self.enabled then
                        return
                    end
                    if multi then
                        local values = self:Get()
                        local index = table.find(values, value)
                        if index then table.remove(values, index) else table.insert(values, value) end
                        self:Set(values)
                    else
                        self:Set(value)
                        self:SetOpen(false)
                    end
                end)
            )
            table.insert(
                self.optionConnections,
                button.MouseEnter:Connect(function()
                    animate(w, button, { BackgroundTransparency = 0.35 }, 0.12)
                end)
            )
            table.insert(
                self.optionConnections,
                button.MouseLeave:Connect(function()
                    animate(w, button, { BackgroundTransparency = 1 }, 0.12)
                end)
            )
        end
        local value
        if multi then
            value = {}
            for _, item in ipairs(self.value or {}) do
                if unique[item] then table.insert(value, item) end
            end
        else value = unique[self.value] and self.value or nil end
        self:Set(value, silent)
        self:SetOpen(self.open)
    end
    local setEnabled = c.SetEnabled
    function c:SetEnabled(value)
        setEnabled(self, value)
        if self.destroyed then
            return
        end
        selected.TextTransparency = self.enabled and 0 or 0.55
        self.icon.ImageTransparency = self.enabled and 0 or 0.55
        if not self.enabled then
            self:SetOpen(false)
        end
    end
    local destroy = c.Destroy
    function c:Destroy()
        for _, connection in ipairs(self.optionConnections) do
            connection:Disconnect()
        end
        table.clear(self.optionConnections)
        destroy(self)
    end
    listen(c, c.hit.Activated, function()
        if c.enabled then
            c:SetOpen(not c.open)
        end
    end)
    listen(c, UIS.InputBegan, function(input)
        if not c.open then
            return
        end
        if input.KeyCode == Enum.KeyCode.Escape then
            c:SetOpen(false)
            return
        end
        if
            input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            local p, size = f.AbsolutePosition, f.AbsoluteSize
            local point = input.Position
            if
                point.X < p.X
                or point.Y < p.Y
                or point.X > p.X + size.X
                or point.Y > p.Y + size.Y
            then
                c:SetOpen(false)
            end
        end
    end)
    listen(c, self.tab.page:GetPropertyChangedSignal("Visible"), function()
        if not self.tab.page.Visible then
            c:SetOpen(false)
        end
    end)
    c:SetOptions(opt(config, "Options", {}), true)
    c:Set(opt(config, "Value", multi and {} or c.options[1]), true)
    c:SetEnabled(c.enabled)
    return c
end

