function state.HandleEmergencyKick(message)
    if not state.active or state.emergencyKick then return false end
    if type(message) ~= "table" or message.type ~= "emergency_kick"
        or type(message.commandId) ~= "string" or #message.commandId < 1 or #message.commandId > 80 then return false end
    state.emergencyKick = message.commandId
    settings.autoFarm = false
    task.defer(function()
        pcall(state.restore)
        player:Kick("Farm Manager emergency shutdown.")
    end)
    return true
end

function state.SetAntiAFK(enabled)
    enabled = enabled == true and state.active
    settings.antiAFK = enabled
    if not enabled then
        if state.antiAFKConnection then
            state.antiAFKConnection:Disconnect()
            state.antiAFKConnection = nil
        end
        for _, connection in ipairs(state.pausedIdleConnections or {}) do
            pcall(function() connection:Enable() end)
        end
        state.pausedIdleConnections = nil
        state.antiAFKFailed = nil
        return
    end
    if state.antiAFKConnection then return end
    state.pausedIdleConnections = {}
    if type(getconnections) == "function" then
        local ok, connections = pcall(getconnections, player.Idled)
        if ok and type(connections) == "table" then
            for _, connection in ipairs(connections) do
                -- Only pause known-enabled handlers, so cleanup preserves their prior state.
                local paused = false
                pcall(function()
                    if connection.Enabled == true and type(connection.Disable) == "function"
                        and type(connection.Enable) == "function" then
                        connection:Disable()
                        paused = true
                    end
                end)
                if paused then table.insert(state.pausedIdleConnections, connection) end
            end
        end
    end
    state.antiAFKConnection = player.Idled:Connect(function()
        if not state.active or not settings.antiAFK then return end
        local input
        local inputOK = pcall(function()
            input = Instance.new("VirtualInputManager")
            input:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        end)
        local releaseOK = false
        if input then
            releaseOK = pcall(function()
                input:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
            pcall(function() input:Destroy() end)
        end
        local ok = inputOK and releaseOK
        if not ok then
            ok = pcall(function()
                local virtualUser = game:GetService("VirtualUser")
                virtualUser:CaptureController()
                virtualUser:ClickButton2(Vector2.zero)
            end)
        end
        if not ok and not state.antiAFKFailed then
            state.antiAFKFailed = true
            if state.OnAntiAFKError then state.OnAntiAFKError() end
        elseif ok then
            state.antiAFKFailed = nil
        end
    end)
end

