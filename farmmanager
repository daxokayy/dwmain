local function hostReadiness()
    if not state.SocketHealthy() then return false, "Offline: host resets paused" end
    if not state.roundKnown then return false, "Waiting for the next round" end
    if next(state.selectedHosts) == nil then return false, "Select at least one host" end
    if os.clock() - state.lastSync > 35 then return false, "Waiting for fresh host reports" end
    local total, full = 0, 0
    for id, name in pairs(state.selectedHosts) do
        total += 1
        local report = state.reports[id]
        if not Players:GetPlayerByUserId(id) then return false, name .. " left the server" end
        if not report or os.clock() - report.receivedAt + report.age > 45 then
            return false, "Waiting for " .. name .. " to report"
        end
        if not report.roundStamp or math.abs(report.roundStamp - state.roundStamp) > 5 then
            return false, name .. ": waiting for this round"
        end
        if report.known and report.full then full += 1 end
    end
    return total > 0 and full == total, tostring(full) .. "/" .. tostring(total) .. " hosts full"
end

-- Potassium documents WebSocket.connect, OnMessage, OnClose, Send and Close.
-- HTTP is used only to mint a short-lived connection ticket, never to poll.
local socketState = { connected = false, generation = 0, counter = 0, pending = {}, connections = {}, lastRx = 0 }
state.transport = socketState

local function acceptSnapshot(data)
    if type(data) ~= "table" or type(data.serverTime) ~= "number" or type(data.reports) ~= "table" then return end
    local reports = {}
    for _, report in ipairs(data.reports) do
        if type(report) == "table" and type(report.userId) == "number" and type(report.seenAt) == "number" then
            reports[report.userId] = {
                full = report.full == true, known = report.known == true, inMatch = report.inMatch == true,
                roundStamp = type(report.roundStamp) == "number" and report.roundStamp or nil,
                age = math.max(0, (data.serverTime - report.seenAt) / 1000), receivedAt = os.clock(),
            }
        end
    end
    state.reports, state.lastSync = reports, os.clock()
end

function state.SocketHealthy()
    return state.active and socketState.connected and os.clock() - socketState.lastRx < 35
end

function state.CloseSocket(reason)
    socketState.connected = false
    socketState.generation += 1
    state.reports, state.lastSync = {}, 0
    state.claim, state.pendingClaimRelease = nil, nil
    if state.farm then state.farm.Release() end
    for _, pending in pairs(socketState.pending) do pending.error = reason or "Disconnected"; pending.done = true end
    socketState.pending = {}
    for _, connection in ipairs(socketState.connections) do connection:Disconnect() end
    socketState.connections = {}
    local socket = socketState.socket
    socketState.socket = nil
    if socket then pcall(function() socket:Close() end) end
    if networkLabel and state.active then
        networkLabel:SetText("Offline autofarm | No reservations; host resets paused")
    end
end

function state.SocketRPC(kind, payload)
    assert(state.SocketHealthy(), "Worker disconnected; using normal autofarm")
    socketState.counter += 1
    local id = tostring(socketState.generation) .. ":" .. tostring(socketState.counter)
    local pending = { sentAt = os.clock() }
    socketState.pending[id] = pending
    local ok = pcall(function()
        socketState.socket:Send(HttpService:JSONEncode({ id = id, type = kind, data = payload or {} }))
    end)
    if not ok then state.CloseSocket("WebSocket send failed") end
    while not pending.done and state.active and os.clock() - pending.sentAt < 5 do task.wait(0.03) end
    socketState.pending[id] = nil
    if not pending.done then
        state.CloseSocket("Worker response timed out")
        error("Worker response timed out; using normal autofarm")
    end
    assert(not pending.error, pending.error)
    if pending.response and (pending.response.status == 429 or pending.response.status == 503) then
        state.CloseSocket("Worker capacity unavailable")
    end
    assert(pending.response and pending.response.ok, "Worker message HTTP " .. tostring(pending.response and pending.response.status))
    return pending.response.data, pending.sentAt
end

local function connectSocket()
    local api = WebSocket or websocket or (syn and syn.websocket)
    assert(api and type(api.connect) == "function", "WebSocket.connect unavailable; using normal autofarm")
    assert(type(sendRequest) == "function", "request() unavailable; using normal autofarm")
    assert(#FARM_KEY >= 32 and not FARM_KEY:find("REPLACE_WITH", 1, true), "Configure FARM_KEY; using normal autofarm")
    assert(game.JobId ~= "", "Join a live server first")
    local ticketResponse = sendRequest({
        Url = WORKER_URL:gsub("/+$", "") .. "/v2/session", Method = "POST", Timeout = 8,
        Headers = { ["Content-Type"] = "application/json", Authorization = "Bearer " .. FARM_KEY },
        Body = HttpService:JSONEncode({ placeId = game.PlaceId, jobId = game.JobId,
            userId = player.UserId, name = player.Name, session = state.session }),
    })
    assert(type(ticketResponse) == "table" and tonumber(ticketResponse.StatusCode) == 200,
        "Connection ticket HTTP " .. tostring(ticketResponse and ticketResponse.StatusCode or "unavailable"))
    local data = HttpService:JSONDecode(ticketResponse.Body or "")
    assert(type(data.ticket) == "string", "Worker did not return a connection ticket")
    if not state.active then return end
    local url = WORKER_URL:gsub("/+$", ""):gsub("^https:", "wss:"):gsub("^http:", "ws:")
        .. "/v2/socket?ticket=" .. HttpService:UrlEncode(data.ticket)
    local socket = api.connect(url)
    if not state.active then pcall(function() socket:Close() end); return end
    socketState.socket = socket
    socketState.generation += 1
    local generation = socketState.generation
    socketState.lastRx = os.clock()
    table.insert(socketState.connections, socket.OnMessage:Connect(function(message)
        if socketState.generation ~= generation then return end
        local decoded, value = pcall(HttpService.JSONDecode, HttpService, message)
        if not decoded or type(value) ~= "table" then return end
        socketState.lastRx = os.clock()
        if state.HandleEmergencyKick(value) then return end
        if value.type == "snapshot" then acceptSnapshot(value.data) end
        local pending = value.id and socketState.pending[value.id]
        if pending then
            pending.response, pending.done = value, true
            if value.ok and value.data and value.data.reports then acceptSnapshot(value.data) end
        end
    end))
    table.insert(socketState.connections, socket.OnClose:Connect(function()
        if socketState.generation == generation then state.CloseSocket("Worker connection closed") end
    end))
    -- Drop an offline target before returning to shared reservations.
    state.claim, state.pendingClaimRelease = nil, nil
    releaseFarmMovement()
    socketState.connected = true
    state.lastReportSignature = nil
    -- Verify the DO can process messages before treating an upgrade as recovery.
    state.SocketRPC("heartbeat", {})
    networkLabel:SetText("Worker connected | Shared reservations active")
end

local function startSocketTransport()
    task.spawn(function()
        local backoff = 2
        local lastHeartbeat = 0
        while state.active do
            if not socketState.connected then
                local ok, err = pcall(connectSocket)
                if not state.active then break end
                if not ok then
                    state.CloseSocket(tostring(err))
                    networkLabel:SetText("Offline autofarm | " .. tostring(err):gsub("^.-:%d+: ", ""))
                    local retryAt = os.clock() + backoff + math.random()
                    while state.active and os.clock() < retryAt do task.wait(0.25) end
                    backoff = math.min(backoff * 2, 300)
                else backoff, lastHeartbeat = 2, os.clock() end
            elseif not state.SocketHealthy() then
                state.CloseSocket("Connection went stale")
            elseif os.clock() - lastHeartbeat >= 20 then
                local ok = pcall(state.SocketRPC, "heartbeat", {})
                if not ok then state.CloseSocket("Heartbeat failed") end
                lastHeartbeat = os.clock()
            end
            task.wait(0.25)
        end
    end)
end

local function syncReports()
    if not state.SocketHealthy() then return end
    local known = state.roundKnown and next(farm.bags) ~= nil
    local payload = {
        sequence = state.sequence + 1, inMatch = farmInMatch(), autoFarm = settings.autoFarm,
        known = known, full = known and farmBagFull() or false,
        bag = farm.bag, maximum = farm.maximum, roundStamp = state.roundStamp,
    }
    -- Coin count changes do not affect the reset condition. Send known/full/round/
    -- alive changes, and let the 20-second connection heartbeat maintain freshness.
    local signature = table.concat({ tostring(payload.inMatch), tostring(payload.autoFarm),
        tostring(payload.known), tostring(payload.full), tostring(payload.roundStamp) }, "|")
    if state.lastReportSignature == signature then return end
    state.sequence = payload.sequence
    local generation = state.transport.generation
    state.SocketRPC("report", payload)
    if generation == state.transport.generation then state.lastReportSignature = signature end
end

-- One nearby coin at a time. Healthy connections use atomic Worker leases;
-- disconnected clients continue ordinary local autofarming without reservations.
local function claimRequest(action, extra, roundStamp)
    local payload = { action = action, roundStamp = roundStamp }
    for key, value in pairs(extra) do payload[key] = value end
    return state.SocketRPC("claim", payload)
end

function state.ClaimValid(coin)
    local claim = state.claim
    if not state.active or not claim or claim.roundStamp ~= state.roundStamp or claim.coin ~= coin then return false end
    if claim.offline then return not state.SocketHealthy() end
    return state.SocketHealthy() and os.clock() < claim.expiresAt
end

function state.ReleaseClaim(immediate)
    local claim = state.claim
    state.claim = nil
    if not claim or claim.offline then return end
    state.pendingClaimRelease = claim
    local function sendRelease()
        if state.pendingClaimRelease ~= claim then return end
        state.pendingClaimRelease = nil
        if state.SocketHealthy() then pcall(claimRequest, "release", { token = claim.token }, claim.roundStamp) end
    end
    if immediate then task.spawn(sendRelease) else task.delay(0.75, sendRelease) end
end

local function localTarget(candidates)
    local candidate = candidates[1]
    local coin = candidate and candidate.coin
    if not coin or not farmReady() or farmBagFull() or not coin:IsDescendantOf(workspace) then return nil end
    state.claim = { coin = coin, offline = true, roundStamp = state.roundStamp }
    updateFarmStatus("Normal autofarm (offline)")
    return coin
end

function state.ClaimCoin(candidates)
    if not farmReady() or farmBagFull() then return nil end
    state.ReleaseClaim()
    if not state.SocketHealthy() then return localTarget(candidates) end
    local options, byId = {}, {}
    for _, candidate in ipairs(candidates) do
        if #options >= 12 then break end
        local position = farm.coinPositions[candidate.coin]
        local id = string.format("%d:%d:%d", math.round(position.X), math.round(position.Y), math.round(position.Z))
        if not byId[id] then
            byId[id] = candidate.coin
            table.insert(options, { id = id, x = position.X, y = position.Y, z = position.Z })
        end
    end
    if #options == 0 then return nil end
    local previous = state.pendingClaimRelease
    state.pendingClaimRelease = nil
    local round, character = state.roundStamp, player.Character
    local ok, data, sentAt = pcall(claimRequest, "acquire", {
        candidates = options, previousToken = previous and previous.token or nil,
    }, round)
    if not ok then
        if state.SocketHealthy() then
            -- An application error isn't an outage; keep a live server lease isolated.
            if previous then state.pendingClaimRelease = previous; task.delay(0.75, function()
                if state.pendingClaimRelease == previous then
                    state.pendingClaimRelease = nil
                    pcall(claimRequest, "release", { token = previous.token }, previous.roundStamp)
                end
            end) end
            error(data)
        end
        if state.roundStamp ~= round or player.Character ~= character then return nil end
        return localTarget(candidates)
    end
    if data.busy then return nil end
    local coin = byId[data.coinId]
    assert(coin and type(data.token) == "string" and type(data.ttlMs) == "number"
        and data.ttlMs > 2000 and data.ttlMs <= 30000, "Invalid Worker coin lease")
    state.claim = { coin = coin, token = data.token, roundStamp = round,
        expiresAt = sentAt + data.ttlMs / 1000 - 2 }
    if not state.active or state.roundStamp ~= round or player.Character ~= character
        or not farmReady() or farmBagFull() or not coin:IsDescendantOf(workspace) then
        state.ReleaseClaim(true)
        return nil
    end
    return coin
end

task.spawn(function()
    while state.active do
        task.wait(0.25)
        local claim = state.claim
        if claim and not claim.offline then
            if not farmReady() or farmBagFull() or not claim.coin:IsDescendantOf(workspace)
                or not state.ClaimValid(claim.coin) then
                state.ReleaseClaim(true)
                releaseFarmMovement()
            elseif os.clock() - (claim.lastRenewed or (claim.expiresAt - 28)) >= 10 then
                local ok, data, sentAt = pcall(claimRequest, "renew", { token = claim.token }, claim.roundStamp)
                if state.claim == claim then
                    if ok and state.ClaimValid(claim.coin) and data.token == claim.token
                        and type(data.ttlMs) == "number" and data.ttlMs > 2000 and data.ttlMs <= 30000 then
                        claim.expiresAt, claim.lastRenewed = sentAt + data.ttlMs / 1000 - 2, sentAt
                    else
                        state.ReleaseClaim(true)
                        releaseFarmMovement()
                    end
                end
            end
        end
    end
end)


local function desiredHostAction(role, isHost, allFull)
    if not isHost or not allFull or type(role) ~= "string" then return nil end
    role = role:lower()
    if role == "murderer" and settings.hostKillAll then return "knife" end
    if role == "sheriff" and settings.hostShootMurderer then return "shot" end
    return nil
end

local function startHostBagAction()
    local ready = hostReadiness()
    local action = desiredHostAction(getRole(player), state.selectedHosts[player.UserId] ~= nil, ready)
    local round = state.roundStamp
    if not action or not farmInMatch() or state.hostActionRound == round then return false end
    if state.hostActionBusy then return true end
    state.hostActionBusy = true
    task.spawn(function()
        local succeeded, message
        local ok, err = xpcall(function()
            pcall(refreshRoleCache)
            local stillReady = hostReadiness()
            local current = desiredHostAction(getRole(player), state.selectedHosts[player.UserId] ~= nil, stillReady)
            if not state.active or state.roundStamp ~= round or current ~= action or not farmInMatch() then return end
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local name = action == "knife" and "Knife" or "Gun"
            local backpack = player:FindFirstChildOfClass("Backpack")
            local tool = character and character:FindFirstChild(name) or backpack and backpack:FindFirstChild(name)
            if not humanoid or humanoid.Health <= 0 or not tool or not tool:IsA("Tool") then
                message = name .. " unavailable for host action"
                state.hostActionRound = round
                return
            end
            state.ReleaseClaim(true)
            releaseFarmMovement()
            humanoid:EquipTool(tool)
            RunService.Heartbeat:Wait()
            local enabled = action == "knife" and settings.hostKillAll or action == "shot" and settings.hostShootMurderer
            if not state.active or not enabled or state.roundStamp ~= round or player.Character ~= character
                or not state.selectedHosts[player.UserId] or not hostReadiness() or tool.Parent ~= character then return end
            state.hostActionRound = round -- one attempt per host/round, regardless of server result
            if action == "knife" then succeeded, message = knifeEveryone()
            else succeeded, message = shootMurderer() end
        end, debug.traceback)
        if state.sheriffShot then state.sheriffShot.Cancel() end
        if state.hostWeaponHooks then state.hostWeaponHooks.Restore() end
        if state.knifeAction then state.knifeAction.Cancel(); state.knifeAction = nil end
        state.hostActionBusy = false
        if state.active and (message or not ok) then
            hostActionLabel:SetText((succeeded and "Host action attempted: " or "Host action: ") .. tostring(message or err))
        end
    end)
    return true
end

local function chooseSafeVote(entries)
    local barn, choices, signature = false, {}, {}
    for index = 1, 3 do
        local entry = entries[index]
        if not entry or not entry.available or type(entry.name) ~= "string" then return nil end
        local name = entry.name:match("^%s*(.-)%s*$"):lower()
        if name == "" then return nil end
        table.insert(signature, name)
        if name == "barn" then barn = true
        else table.insert(choices, { index = index, name = name }) end
    end
    if not barn then return nil, "No Barn offered" end
    table.sort(choices, function(a, b) return a.name == b.name and a.index < b.index or a.name < b.name end)
    return choices[1] and choices[1].index, table.concat(signature, "|")
end

local function updateMapVote()
    if not state.active or not settings.avoidInfection then return end
    if farmInMatch() or state.hostActionBusy then return end
    local lobby = workspace:FindFirstChild("Lobby")
    local pads = lobby and lobby:FindFirstChild("VotePads")
    if not pads then state.mapVoteSignature = nil; return end
    local entries = {}
    for index = 1, 3 do
        local padModel = pads:FindFirstChild("VotePad" .. index)
        local gui = padModel and padModel:FindFirstChild("VoteInfoGui")
        local container = gui and gui:FindFirstChild("Container")
        local label = container and container:FindFirstChild("MapName")
        local pad = padModel and padModel:FindFirstChild("Pad")
        local visible = gui and (not gui:IsA("LayerCollector") or gui.Enabled)
            and container and (not container:IsA("GuiObject") or container.Visible)
            and label and label:IsA("TextLabel") and label.Visible
        entries[index] = { name = label and label:IsA("TextLabel") and label.Text or "",
            available = visible and pad and pad:IsA("BasePart"), pad = pad }
    end
    local index, signature = chooseSafeVote(entries)
    if not index then
        state.mapVoteSignature = nil
        mapVoteLabel:SetText(signature == "No Barn offered" and "No Barn offered; vote unchanged" or "Waiting for voting pads")
        return
    end
    if signature == state.mapVoteSignature then return end
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return end
    local pad = entries[index].pad
    -- Avoid teleporting an active/stranded match character back to the lobby.
    if (root.Position - pad.Position).Magnitude > 150 then return end
    state.ReleaseClaim(true)
    releaseFarmMovement()
    character:PivotTo(pad.CFrame + Vector3.new(0, pad.Size.Y / 2 + 3, 0))
    state.mapVoteSignature = signature
    mapVoteLabel:SetText("Voted " .. entries[index].name .. " (avoiding Barn)")
    if type(firetouchinterest) == "function" then
        pcall(firetouchinterest, root, pad, 0)
        RunService.Heartbeat:Wait()
        pcall(firetouchinterest, root, pad, 1)
    end
end

task.spawn(function()
    while state.active do
        local ok, err = pcall(updateMapVote)
        if not ok and state.active then mapVoteLabel:SetText("Map vote: " .. tostring(err)) end
        task.wait(0.5)
    end
end)


