    c.label = label(
        c.hit,
        "Label",
        opt(config, "Name", opt(config, "Text", "Button")),
        15,
        UDim2.fromOffset(13, 0),
        UDim2.new(1, -26, 1, 0)
    )
    local iconName = opt(config, "Icon", 125304603079291)
    if iconName then
        local iconSize = math.clamp(opt(config, "IconSize", 20), 12, 28)
        c.icon = addIcon(c.hit, iconName, UDim2.new(0, 9, 0.5, -iconSize / 2), iconSize)
        c.label.Position = UDim2.fromOffset(17 + iconSize, 0)
        c.label.Size = UDim2.new(1, -30 - iconSize, 1, 0)
        c.icon:SetAttribute("FixedColor", true)
        c.icon.AnchorPoint = Vector2.new(0.5, 0.5)
        c.icon.Position = UDim2.new(0, 9 + iconSize / 2, 0.5, 0)
        c.iconScale = make("UIScale", { Scale = 1 }, c.icon)
        local function matchText()
            c.icon.ImageColor3 = c.label.TextColor3
            c.icon.ImageTransparency = c.label.TextTransparency
        end
        matchText()
        listen(c, c.label:GetPropertyChangedSignal("TextColor3"), matchText)
        listen(c, c.label:GetPropertyChangedSignal("TextTransparency"), matchText)
    end
    local hovered = false
    c.busy = false
    local function paint(pressed)
        animate(w, c.hit, {
            BackgroundTransparency = c.enabled and (pressed and 0.1 or hovered and 0.55 or 1) or 1,
        }, 0.13)
    end
    listen(c, c.hit.MouseEnter, function()
        hovered = true
        paint(false)
    end)
    listen(c, c.hit.MouseLeave, function()
        hovered = false
        paint(false)
    end)
    listen(c, c.hit.InputBegan, function(input)
        if
            c.enabled
            and (
                input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch
            )
        then
            paint(true)
        end
    end)
    listen(c, c.hit.Activated, function()
        if c.enabled and c.icon then
            c.iconToken = (c.iconToken or 0) + 1
            local token = c.iconToken
            animate(w, c.iconScale, { Scale = 0.78 }, 0.08)
            animate(w, c.icon, { Rotation = -14 }, 0.08)
            task.delay(0.08, function()
                if not c.destroyed and c.icon.Parent and token == c.iconToken then
                    animate(w, c.iconScale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
                    animate(w, c.icon, { Rotation = 0 }, 0.25, Enum.EasingStyle.Back)
                end
            end)
        end
        if not c.enabled or c.busy then
            return
        end
        c.busy = true
        paint(true)
        task.spawn(function()
            local ok, err = pcall(function()
                if c.callback then
                    c.callback(c)
                end
            end)
            c.busy = false
            if not ok then
                warn("[daxware] Button:", err)
            end
            if not c.destroyed then
                paint(false)
            end
        end)
    end)
    c:SetEnabled(c.enabled)
    return c
end

