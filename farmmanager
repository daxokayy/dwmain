local function applyPlayerData(data)
    if not state.active or type(data) ~= "table" then
        return false
    end
    local updated, updatedDead = {}, {}
    for key, value in pairs(data) do
        local role = type(value) == "table" and value.Role
        if type(role) == "string" then
            local subject
            if typeof(key) == "Instance" and key:IsA("Player") then
                subject = key
            elseif type(key) == "string" then
                subject = Players:FindFirstChild(key)
            elseif type(key) == "number" then
                subject = Players:GetPlayerByUserId(key)
            end
            if subject then
                updated[subject.UserId] = role
                updated[subject.Name] = role
                local dead = value.Dead == true or value.Killed == true
                updatedDead[subject.UserId], updatedDead[subject.Name] = dead, dead
            elseif type(key) == "string" or type(key) == "number" then
                updated[key] = role
                updatedDead[key] = value.Dead == true or value.Killed == true
            end
        end
    end
    table.clear(roleCache)
    for key, role in pairs(updated) do
        roleCache[key] = role
    end
    table.clear(deadCache)
    for key, dead in pairs(updatedDead) do
        deadCache[key] = dead
    end
    return true
end

local function refreshRoleCache()
    if not state.active then
        return false
    end
    if usesRoleEvent then
        local remotes = RS:FindFirstChild("Remotes")
        local gameplay = remotes and remotes:FindFirstChild("Gameplay")
        local event = gameplay and gameplay:FindFirstChild("PlayerDataChanged")
        if
            roleEventConnection
            and roleEventConnection.Connected
            and connectedRoleEvent == event
        then
            return true
        end
        if roleEventConnection then
            roleEventConnection:Disconnect()
        end
        roleEventConnection, connectedRoleEvent = nil, nil
        table.clear(roleCache)
        table.clear(deadCache)
        if not event or not event:IsA("RemoteEvent") then
            return false
        end
        connectedRoleEvent = event
        roleEventConnection = event.OnClientEvent:Connect(applyPlayerData)
        return true
    end
    local remote = RS:FindFirstChild("GetPlayerData", true)
    if not remote or not remote:IsA("RemoteFunction") then
        return false
    end
    local ok, data = pcall(function()
        return remote:InvokeServer()
    end)
    if not ok then
        return false
    end
    return applyPlayerData(data)
end

local farm = {
    bag = 0,
    maximum = nil,
    fullHandled = false,
    full = false,
    speed = 20,
    bags = {},
    uiSnapshots = {},
    connections = {},
}
state.farm = farm

local function updateFarmStatus(message)
    if farm.label then
        farm.label:SetText(
            message .. " | Bag: " .. farm.bag .. "/" .. tostring(farm.maximum or "?")
        )
    end
end

local function releaseFarmMovement()
    local movement = farm.movement
    farm.movement = nil
    if not movement then
        return
    end
    for part, collision in pairs(movement.collisions) do
        if part.Parent then
            part.CanCollide = collision
        end
    end
    if player.Character == movement.character and movement.root.Parent then
        movement.root.AssemblyLinearVelocity = Vector3.zero
        movement.root.AssemblyAngularVelocity = Vector3.zero
        if movement.humanoid.Parent then
            movement.humanoid.AutoRotate = movement.autoRotate
            movement.humanoid.PlatformStand = movement.platformStand
            if movement.humanoid.Health > 0 and not movement.platformStand then
                movement.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
    end
end

farm.Release = releaseFarmMovement

function farm.Stop()
    releaseFarmMovement(true)
    for _, connection in ipairs(farm.connections) do
        connection:Disconnect()
    end
    table.clear(farm.connections)
end

local function farmBagFull()
    return farm.full or (farm.maximum ~= nil and farm.bag >= farm.maximum)
end

local function setFarmBag(kind, current, maximum, uiFull)
    local previous = farm.bags[kind]
    local entry = {
        current = current,
        maximum = maximum or (previous and previous.maximum),
        uiFull = uiFull == true,
    }
    farm.bags[kind] = entry
    farm.bag, farm.maximum = current, entry.maximum
    farm.full = false
    for _, bag in pairs(farm.bags) do
        if bag.uiFull or (bag.maximum and bag.current >= bag.maximum) then
            farm.full = true
            farm.bag, farm.maximum = bag.current, bag.maximum
            break
        end
    end
    if not farm.full then
        farm.fullHandled = false
    else
        releaseFarmMovement()
    end
    updateFarmStatus(farm.full and "Bag full" or settings.autoFarm and "Farming" or "Idle")
end

local function scanFarmBagUI(baselineOnly)
    if not state.roundKnown then return end
    local gui = player:FindFirstChild("PlayerGui")
    local main = gui and gui:FindFirstChild("MainGUI")
    local gameFrame = main and main:FindFirstChild("Game")
    local bags = gameFrame and gameFrame:FindFirstChild("CoinBags")
    local container = bags and bags:FindFirstChild("Container")
    if not container then
        return
    end
    for _, bag in ipairs(container:GetChildren()) do
        if bag:IsA("Frame") and bag.Visible then
            local currency = bag:FindFirstChild("CurrencyFrame")
            local icon = currency and currency:FindFirstChild("Icon")
            local text = icon and icon:FindFirstChild("Coins")
            local count = text and tonumber(text.Text)
            local full = bag:FindFirstChild("Full")
            local fullIcon = bag:FindFirstChild("FullBagIcon")
            local isFull = (full and full.Visible == true)
                or (fullIcon and fullIcon.Visible == true)
                or false
            if count then
                local signature = tostring(count) .. ":" .. tostring(isFull)
                if farm.uiSnapshots[bag.Name] ~= signature then
                    farm.uiSnapshots[bag.Name] = signature
                    if not baselineOnly then
                        local previous = farm.bags[bag.Name]
                        if not previous or isFull or not previous.authoritative then
                            setFarmBag(bag.Name, count, nil, isFull)
                        end
                    end
                end
            end
        end
    end
end

local function farmInMatch()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if
        not character
        or not character:IsDescendantOf(workspace)
        or not humanoid
        or humanoid.Health <= 0
        or not root
    then
        return false
    end
    local role = roleCache[player.UserId] or roleCache[player.Name]
    if type(role) ~= "string" then
        return false
    end
    role = role:lower()
    if
        role == ""
        or role == "unknown"
        or role == "spectator"
        or role == "lobby"
        or role == "none"
    then
        return false
    end
    -- Infection conversion can keep normal-mode death flags on a living zombie.
    -- The character/root/health checks above still apply; never revive a corpse.
    local infected = role:find("zombie", 1, true) ~= nil or role == "infected"
    if infected then
        return true
    end
    if player:GetAttribute("Alive") == false then
        return false
    end
    if deadCache[player.UserId] == true or deadCache[player.Name] == true then
        return false
    end
    return deadCache[player.UserId] == false
        or deadCache[player.Name] == false
        or player:GetAttribute("Alive") == true
end

local function farmReady()
    return state.active
        and settings.autoFarm
        and not state.hostActionBusy
        and state.roundKnown
        and farmInMatch()
        and not state.flingTrip
        and not state.gunPickupRunning
        and not settings.touchFling
        and not state.sheriffShot
        and not state.knifeAction
        and not (
            state.connector
            and (
                state.connector.gameplayEffect
                or state.connector.control
                or os.clock() < (state.connector.gameplayPauseUntil or 0)
            )
        )
end

local function refreshFarmCoins(force)
    if not force and farm.coins and os.clock() < (farm.scanAt or 0) then
        return false
    end
    local coins, positions, seen = {}, {}, {}
    for _, container in ipairs(workspace:GetDescendants()) do
        if container.Name == "CoinContainer" then
            for _, descendant in ipairs(container:GetDescendants()) do
                local part = descendant:IsA("TouchTransmitter") and descendant.Parent
                if part and part:IsA("BasePart") and not seen[part] then
                    seen[part] = true
                    positions[part] = part.Position
                    table.insert(coins, part)
                end
            end
        end
    end
    farm.coins, farm.coinPositions = coins, positions
    farm.scanAt = os.clock() + 1
    return true
end

local function prepareFarmPhysics(movement)
    for _, part in ipairs(movement.character:GetDescendants()) do
        if part:IsA("BasePart") then
            if movement.collisions[part] == nil then
                movement.collisions[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end
    movement.humanoid.AutoRotate = false
    movement.humanoid.PlatformStand = true
    if movement.humanoid:GetState() ~= Enum.HumanoidStateType.Physics then
        movement.humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    end
end

-- Count real collection acknowledgements independently of GUI polling.
local function recordFarmCollection(kind, current)
    farm.eventCounts = farm.eventCounts or {}
    local previous = farm.eventCounts[kind] or 0
    farm.eventCounts[kind] = current
    if current > previous then
        farm.collectionRevision = (farm.collectionRevision or 0) + 1
    end
end

local function farmCollectionConfirmed(coin, revision, root)
    if not coin:IsDescendantOf(workspace) or not coin:FindFirstChildOfClass("TouchTransmitter") then
        return true -- Gone/claimed already: choose another target immediately.
    end
    -- CoinCollected has no coin ID. Only associate an increase with a nearby target.
    return (farm.collectionRevision or 0) > revision
        and root and root.Parent ~= nil and (coin.Position - root.Position).Magnitude <= 6
end

local function waitForFarmCollection(coin, revision, root)
    local deadline = os.clock() + 0.75
    repeat
        if farmCollectionConfirmed(coin, revision, root) or farmBagFull() then return true end
        if not farmReady() or not root or not root.Parent
            or (state.ClaimValid and not state.ClaimValid(coin)) then return false end
        RunService.Heartbeat:Wait()
    until os.clock() >= deadline
    return false -- No acknowledgement: don't hang forever on a missed coin.
end

local function glideTo(position, targetCoin)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = humanoid and humanoid.RootPart
    if not root or humanoid.Health <= 0 or not farmReady() or farmBagFull()
        or not state.ClaimValid(targetCoin) then
        return false
    end
    if not farm.movement then
        farm.movement = {
            character = character,
            humanoid = humanoid,
            root = root,
            autoRotate = humanoid.AutoRotate,
            platformStand = humanoid.PlatformStand,
            collisions = {},
            hold = root.CFrame,
        }
    end
    local movement = farm.movement
    if movement.character ~= character then
        releaseFarmMovement(false)
        return false
    end
    humanoid.AutoRotate = false
    local activeSpeed = farm.speed
    local deadline = os.clock() + (root.Position - position).Magnitude / activeSpeed + 3
    movement.lastStepAt = os.clock()
    local progressAt = os.clock()
    local progressDistance = (root.Position - position).Magnitude
    local collectionRevision = farm.collectionRevision or 0
    while farmReady() and state.ClaimValid(targetCoin) and os.clock() < deadline do
        if farm.speed ~= activeSpeed then
            activeSpeed = farm.speed
            deadline = os.clock() + (root.Position - position).Magnitude / activeSpeed + 3
        end
        if targetCoin and farmCollectionConfirmed(targetCoin, collectionRevision, root) then
            return true
        end
        local refreshed = refreshFarmCoins(false)
        if targetCoin then
            if
                not targetCoin:IsDescendantOf(workspace)
                or not targetCoin:FindFirstChildOfClass("TouchTransmitter")
                or not farm.coinPositions[targetCoin]
            then
                return false, "Coin no longer in CoinContainer"
            end
            if refreshed and (farm.coinPositions[targetCoin] - position).Magnitude > 0.75 then
                return false, "Coin changed position; selecting another"
            end
        end
        if player.Character ~= character or not root.Parent or humanoid.Health <= 0 then
            return false
        end
        if farmBagFull() then
            return false
        end
        prepareFarmPhysics(movement)
        local delta = position - root.Position
        if delta.Magnitude <= 0.25 then
            return true
        end
        if progressDistance - delta.Magnitude >= 0.5 then
            progressDistance = delta.Magnitude
            progressAt = os.clock()
        elseif os.clock() - progressAt >= 2 then
            return false, "No movement progress"
        end
        local dt = RunService.Heartbeat:Wait()
        if not farmReady() or farmBagFull() or farm.movement ~= movement
            or not state.ClaimValid(targetCoin) then
            return false
        end
        if player.Character ~= character or not root.Parent or humanoid.Health <= 0 then
            return false
        end
        local now = os.clock()
        local elapsed = math.max(0, math.min(dt, now - movement.lastStepAt, 0.1))
        movement.lastStepAt = now
        delta = position - root.Position
        if delta.Magnitude <= 0.25 then
            return true
        end
        local offset = delta.Unit * math.min(delta.Magnitude, farm.speed * elapsed)
        character:PivotTo(character:GetPivot() + offset)
        movement.hold = root.CFrame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    return false
end

local function onFarmFull()
    releaseFarmMovement()
    updateFarmStatus("Bag full; waiting for hosts")
end

local function startFarmObserver()
    local remotes = RS:FindFirstChild("Remotes")
    local gameplay = remotes and remotes:FindFirstChild("Gameplay")
    local collected = gameplay and gameplay:FindFirstChild("CoinCollected")
    local started = gameplay and gameplay:FindFirstChild("CoinsStarted")
    if not collected or not started then
        updateFarmStatus("Coin events unavailable")
        return
    end
    table.insert(
        farm.connections,
        collected.OnClientEvent:Connect(function(kind, current, maximum)
            if
                type(kind) ~= "string"
                or type(current) ~= "number"
                or type(maximum) ~= "number"
                or current ~= current
                or maximum ~= maximum
                or current < 0
                or maximum <= 0
                or math.abs(current) == math.huge
                or math.abs(maximum) == math.huge
            then
                return
            end
            if not state.roundKnown then return end
            recordFarmCollection(kind, current)
            setFarmBag(kind, current, maximum, false)
            farm.bags[kind].authoritative = true
        end)
    )
    table.insert(
        farm.connections,
        started.OnClientEvent:Connect(function()
            if state.ReleaseClaim then state.ReleaseClaim(true) end
            state.mapVoteSignature = nil
            state.roundStamp = workspace:GetServerTimeNow()
            state.reports = {}
            state.lastSync = 0
            state.roundKnown = true
            farm.bag, farm.maximum, farm.fullHandled, farm.full = 0, nil, false, false
            table.clear(farm.bags)
            farm.eventCounts = {}
            farm.advanceNow = false
            table.clear(farm.uiSnapshots)
            scanFarmBagUI(true)
            farm.coins, farm.scanAt = nil, 0
            releaseFarmMovement(true)
            updateFarmStatus("New round")
        end)
    )
    scanFarmBagUI(false)
    local nextBagUIScan = 0
    table.insert(
        farm.connections,
        RunService.PreSimulation:Connect(function()
            if os.clock() >= nextBagUIScan then
                nextBagUIScan = os.clock() + 0.2
                scanFarmBagUI(false)
            end
            if farmBagFull() or not farmInMatch()
                or (farm.movement and (not state.claim or not state.ClaimValid(state.claim.coin))) then
                releaseFarmMovement()
                return
            end
            local movement = farm.movement
            if
                movement
                and movement.hold
                and farmReady()
                and player.Character == movement.character
                and movement.root.Parent
                and movement.humanoid.Health > 0
            then
                prepareFarmPhysics(movement)
                movement.root.CFrame = movement.hold
                movement.root.AssemblyLinearVelocity = Vector3.zero
                movement.root.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    )
    task.spawn(function()
        local cooldown = setmetatable({}, { __mode = "k" })
        while state.active do
            if farm.advanceNow then
                farm.advanceNow = false
                RunService.Heartbeat:Wait()
            else
                task.wait(0.15)
            end
            if not farmReady() then
                state.ReleaseClaim()
                releaseFarmMovement(not state.flingTrip and not state.gunPickupRunning)
                if settings.autoFarm and not state.roundKnown then
                    updateFarmStatus("Waiting for the next round")
                elseif settings.autoFarm and not farmInMatch() then
                    updateFarmStatus("Waiting for an active match")
                end
                continue
            end
            local ok, message = xpcall(function()
                if farmBagFull() then
                    onFarmFull()
                    return
                end
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local root = humanoid and humanoid.RootPart
                if not root or humanoid.Health <= 0 then
                    releaseFarmMovement(false)
                    return
                end
                refreshFarmCoins(false)
                local candidates = {}
                for _, coin in ipairs(farm.coins) do
                    if
                        coin:IsDescendantOf(workspace)
                        and farm.coinPositions[coin] ~= nil
                        and coin:FindFirstChildOfClass("TouchTransmitter")
                        and os.clock() >= (cooldown[coin] or 0)
                    then
                        table.insert(candidates, { coin = coin, distance = (coin.Position - root.Position).Magnitude })
                    end
                end
                table.sort(candidates, function(a, b) return a.distance < b.distance end)
                -- Keep each reservation local: shortlist the nearest 12 coins within
                -- 40 studs of the closest candidate's distance. Wait if all are busy.
                local nearby = {}
                local limit = candidates[1] and candidates[1].distance + 40 or 0
                for _, candidate in ipairs(candidates) do
                    if #nearby >= 12 or candidate.distance > limit then break end
                    table.insert(nearby, candidate)
                end
                releaseFarmMovement()
                local nearest = state.ClaimCoin(nearby)
                if not nearest then
                    releaseFarmMovement(true)
                    updateFarmStatus("Waiting for a nearby unclaimed coin")
                    task.wait(0.75)
                    return
                end
                updateFarmStatus(state.claim and state.claim.offline
                    and "Farming offline (unreserved)" or "Farming (reserved)")
                local destination = nearest.Position
                local collectionRevision = farm.collectionRevision or 0
                local arrived = glideTo(destination, nearest)
                cooldown[nearest] = os.clock() + (arrived and 3 or 10)
                if arrived and farmCollectionConfirmed(nearest, collectionRevision, root) then
                    farm.advanceNow = true
                end
                if not arrived then
                    releaseFarmMovement()
                    farm.scanAt = 0
                    updateFarmStatus("Trying another coin")
                end
                if
                    arrived
                    and farmReady()
                    and not farmBagFull()
                    and state.ClaimValid(nearest)
                    and nearest:IsDescendantOf(workspace)
                then
                    local touching = false
                    if not farmCollectionConfirmed(nearest, collectionRevision, root)
                        and type(firetouchinterest) == "function" then
                        touching = pcall(firetouchinterest, root, nearest, 0)
                    end
                    farm.advanceNow = waitForFarmCollection(nearest, collectionRevision, root)
                    if touching then pcall(firetouchinterest, root, nearest, 1) end
                    cooldown[nearest] = os.clock() + 3
                end
            end, debug.traceback)
            state.ReleaseClaim()
            if not ok then
                releaseFarmMovement(true)
                warn("Daxware farm: " .. tostring(message))
                updateFarmStatus("Farm error; retrying")
                task.wait(1)
            end
        end
        state.ReleaseClaim()
        releaseFarmMovement(true)
    end)
end

local function skipFarmTarget(subject) return subject == player end
local function getRole(subject)
    local role = roleCache[subject.UserId] or roleCache[subject.Name]
    if type(role) ~= "string" then return "Unknown" end
    local canonical = { murderer = "Murderer", sheriff = "Sheriff", hero = "Hero", innocent = "Innocent" }
    return canonical[role:lower()] or role
end

local function installFarmShotHooks()
    local services = RS:FindFirstChild("ClientServices")
    local module = services and services:FindFirstChild("WeaponService")
    if not module then return nil, "WeaponService is unavailable" end
    local loaded, service = pcall(require, module)
    if not loaded or type(service) ~= "table" then return nil, "Could not load WeaponService" end
    if type(service.GetMouseTargetCFrame) ~= "function" or type(service.GetTargetPosition) ~= "function" then
        return nil, "WeaponService aiming methods are unavailable"
    end
    local mouseOriginal, positionOriginal = service.GetMouseTargetCFrame, service.GetTargetPosition
    local function aim()
        local shot = state.sheriffShot
        return shot and shot.Update()
    end
    local function mouseWrapper(self, ...)
        local target = aim()
        if target then return target end
        return mouseOriginal(self, ...)
    end
    local function positionWrapper(self, ...)
        local target = aim()
        if target then return target end
        return positionOriginal(self, ...)
    end
    local hooks, connection = {}, nil
    state.hostWeaponHooks = hooks
    function hooks.Restore()
        if connection then connection:Disconnect() end
        if service.GetMouseTargetCFrame == mouseWrapper then service.GetMouseTargetCFrame = mouseOriginal end
        if service.GetTargetPosition == positionWrapper then service.GetTargetPosition = positionOriginal end
        if state.hostWeaponHooks == hooks then state.hostWeaponHooks = nil end
    end
    service.GetMouseTargetCFrame, service.GetTargetPosition = mouseWrapper, positionWrapper
    connection = RunService.PreSimulation:Connect(function() pcall(aim) end)
    return hooks
end


local function createMurdererShot()
    local character = player.Character
    local gun = character and character:FindFirstChild("Gun")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local attachment = root and root:FindFirstChild("GunRaycastAttachment")
    if not gun or not gun:IsA("Tool") then
        return nil, "Equip your gun first"
    end
    if not humanoid or humanoid.Health <= 0 then
        return nil, "No living character"
    end
    if not attachment or not attachment:IsA("Attachment") then
        return nil, "Gun attachment missing"
    end
    local target
    for _, subject in ipairs(Players:GetPlayers()) do
        local other = subject.Character
        local health = other and other:FindFirstChildOfClass("Humanoid")
        if
            subject ~= player
            and not skipFarmTarget(subject)
            and getRole(subject) == "Murderer"
            and health
            and health.Health > 0
            and other:FindFirstChild("HumanoidRootPart")
            and subject:GetAttribute("Alive") ~= false
            and deadCache[subject.UserId] ~= true
            and deadCache[subject.Name] ~= true
        then
            target = subject
            break
        end
    end
    if not target then
        return nil, "No living murderer detected"
    end
    local targetCharacter = target.Character
    local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
    local originalAttachment = attachment.CFrame
    local direction = targetRoot.Position - root.Position
    direction = direction.Magnitude < 0.001 and Vector3.new(0, 0, -1) or direction.Unit
    local shot = { cancelled = false, gun = gun }
    function shot.Valid()
        return state.active and settings.hostShootMurderer and state.selectedHosts[player.UserId] ~= nil
            and not shot.cancelled
            and player.Character == character
            and target.Parent == Players
            and not skipFarmTarget(target)
            and target.Character == targetCharacter
            and gun.Parent == character
            and attachment.Parent == root
            and targetRoot.Parent ~= nil
            and targetCharacter:IsDescendantOf(workspace)
            and humanoid.Health > 0
            and targetHumanoid.Health > 0
            and target:GetAttribute("Alive") ~= false
            and deadCache[target.UserId] ~= true
            and deadCache[target.Name] ~= true
            and getRole(target) == "Murderer"
    end
    function shot.Cancel()
        if shot.cancelled then
            return
        end
        shot.cancelled = true
        pcall(function()
            attachment.CFrame = originalAttachment
        end)
        if state.sheriffShot == shot then
            pcall(function()
                gun:Deactivate()
            end)
            state.sheriffShot = nil
        end
        if state.autoShot == shot then
            state.autoShot = nil
        end
    end
    function shot.Update()
        if not shot.Valid() then
            shot.Cancel()
            return nil
        end
        local center = targetRoot.Position
        local localDirection = targetRoot.CFrame:VectorToObjectSpace(direction)
        local half = targetRoot.Size / 2
        local boundary = math.huge
        for _, axis in ipairs({ "X", "Y", "Z" }) do
            local component = math.abs(localDirection[axis])
            if component > 0.00001 then
                boundary = math.min(boundary, half[axis] / component)
            end
        end
        local origin = center - direction * (boundary + 1)
        attachment.WorldCFrame = CFrame.lookAt(origin, center)
        return CFrame.new(center)
    end
    return shot
end

local function shootMurderer()
    if not state.active then
        return false, "Script is unloaded"
    end
    if state.sheriffShot then
        return false, "A shot is already running"
    end
    if state.autoShot then
        state.autoShot.Cancel()
    end
    local shot, reason = createMurdererShot()
    if not shot then
        return false, reason
    end
    state.sheriffShot = shot
    local hooks, reason = installFarmShotHooks()
    if not hooks then shot.Cancel(); return false, reason end
    state.hostWeaponHooks = hooks
    local ok, err = pcall(function()
        if not shot.Update() then
            return
        end
        shot.gun:Activate()
        task.wait(0.35)
    end)
    shot.Cancel()
    hooks.Restore()
    return ok, ok and "Gun activated toward murderer" or tostring(err)
end

local function knifeEveryone(alreadyActivated, selectedTarget)
    if not state.active then
        return false, "Script is unloaded"
    end
    if state.knifeAction then
        return false, "Knife action is already running"
    end
    if
        selectedTarget
        and (
            selectedTarget.Parent ~= Players
            or selectedTarget == player
            or skipFarmTarget(selectedTarget)
        )
    then
        return false, "Selected player is unavailable or whitelisted"
    end
    local character = player.Character
    local tool = character and character:FindFirstChild("Knife")
    local handle = tool and tool:FindFirstChild("Handle")
    if not tool or not tool:IsA("Tool") then
        return false, "Equip your knife first"
    end
    if not handle or not handle:IsA("BasePart") then
        return false, "Knife handle unavailable"
    end
    if type(firetouchinterest) ~= "function" then
        return false, "firetouchinterest unavailable"
    end
    local action = { cancelled = false }
    state.knifeAction = action
    function action.Cancel()
        action.cancelled = true
        pcall(function()
            tool:Deactivate()
        end)
    end
    local attempted = 0
    local ok, err = pcall(function()
        if not alreadyActivated then
            tool:Activate()
        end
        task.wait(0.1)
        local targets = selectedTarget and { selectedTarget } or Players:GetPlayers()
        for _, target in ipairs(targets) do
            if
                not state.active or not settings.hostKillAll or not state.selectedHosts[player.UserId]
                or action.cancelled
                or player.Character ~= character
                or tool.Parent ~= character
                or not handle.Parent
            then
                break
            end
            if target == player or skipFarmTarget(target) then
                continue
            end
            local targetCharacter = target.Character
            local humanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
            local root = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
                local began, touchError = pcall(firetouchinterest, handle, root, 0)
                if began then
                    task.wait()
                    local ended, endError = pcall(firetouchinterest, handle, root, 1)
                    attempted += 1
                    if not ended and state.active then
                    end
                elseif state.active then
                end
            end
        end
    end)
    action.Cancel()
    if state.knifeAction == action then
        state.knifeAction = nil
    end
    return ok, ok and ("Touch pairs sent: " .. attempted) or tostring(err)
end


