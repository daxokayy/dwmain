                if not userId then
                    output("Usage: ;unblacklist <userId>")
                    return
                end
                local _, message = blacklist({ userId = userId }, nil, nil, true)
                output(message)
                return
            end
            local targetName, tail = arguments:match("^(%S+)%s*(.*)$")
            local target, errorMessage = resolveTarget(targetName)
            if not target then
                output(errorMessage)
                return
            end
            if target == "." and game.JobId == "" then
                output("No live server ID; . is unavailable in Studio")
                return
            end
            tail = tail or ""
            local kind, payload
            if name == "control" then
                startControl(target)
                return
            elseif name == "accepttrade" then
                if target == "." then
                    output("Trade acceptance requires one selected username")
                    return
                end
                kind, payload = "trade_accept", {}
            elseif name == "tradereview" then
                kind, payload = "trade_review", {}
            elseif name == "explode" or name == "flashbang" then
                kind, payload = name, {}
            elseif name == "bring" then
                kind, payload = "bring", destination()
                if not payload then
                    output("Your character or live server is unavailable")
                    return
                end
            elseif name == "kill" or name == "fling" then
                kind, payload = name, {}
            elseif name == "kick" then
                kind, payload =
                    "disconnect",
                    { reason = tail ~= "" and tail or "Disconnected by daxware developer" }
            elseif name == "ragdoll" then
                kind, payload = "ragdoll", { seconds = tonumber(tail) or 5 }
            elseif name == "gravity" or name == "invertgravity" then
                kind, payload = "invert_gravity", { seconds = tonumber(tail) or 5 }
            elseif name == "say" then
                if tail == "" then
                    output("Usage: ;say <target> <message>")
                    return
                end
                kind, payload = "notify", { text = tail }
            elseif name == "blacklist" then
                local minutes, reason = tail:match("^(%d+)%s*(.*)$")
                local _, message = blacklist(
                    target,
                    tonumber(minutes) or 10,
                    reason and reason ~= "" and reason
                        or tail ~= "" and not minutes and tail
                        or "Temporarily blacklisted"
                )
                output(message)
                return
            else
                output("Unknown command. Type ;help.")
                return
            end
            local _, message = queue(target, kind, payload)
            output(message or "Request sent")
        end
        local commandBusy = false
        local function submitCommand(line)
            if commandBusy then
                output("A command is still processing; try again shortly")
                return
            end
            if #line > 1000 then
                output("Command too long")
                return
            end
            output("> " .. line)
            commandBusy = true
            task.spawn(function()
                local ok = pcall(command, line)
                if not ok then
                    output("Command failed; check the connection and selection")
                end
                commandBusy = false
            end)
        end
        connect(consoleInput.FocusLost, function(enter)
            if not enter then
                return
            end
            local line = consoleInput.Text
            consoleInput.Text = ""
            submitCommand(line)
        end)
        local TextChatService = game:GetService("TextChatService")
        connect(TextChatService.SendingMessage, function(message)
            if not adminToken then
                return
            end
            local channel = message.TextChannel
            if not channel or channel.Name ~= "RBXGeneral" then
                return
            end
            local line = message.Text
            if type(line) == "string" and line:match("^;[%w_]+") then
                submitCommand(line)
            end
        end)
        output(
            "Type ;help here or in Roblox general chat after signing in. Chat commands remain visible in chat."
        )

        backendAction = function(action)
            local session = activeSession()
            if not session or not adminToken then
                return
            end
            if advancedActions[action] then
                local permission = session.permissions or {}
                if
                    action ~= "Temp blacklist"
                    and (
                        not session.interactions
                        or action == "Kick" and not permission.disconnect
                        or action == "Flashbang" and not permission.flashbang
                        or action == "Accept current trade" and not permission.tradeAccept
                        or action == "Control" and (not permission.control or not permission.gameplay)
                        or (
                                action ~= "Kick"
                                and action ~= "Flashbang"
                                and action ~= "Control"
                                and action ~= "Release control"
                                and action ~= "Request trade review"
                                and action ~= "Accept current trade"
                            )
                            and not permission.gameplay
                    )
                then
                    sessions.Subtitle.Text = "Required permission is disabled on this session"
                    return
                end
                advancedAction(action, session)
                return
            end
            if action == "Join server" then
                if
                    session.shareLocation
                    and session.placeId
                    and session.jobId
                    and session.jobId ~= ""
                then
                    local ok = pcall(function()
                        game:GetService("TeleportService"):TeleportToPlaceInstance(
                            session.placeId,
                            session.jobId,
                            Players.LocalPlayer
                        )
                    end)
                    if not ok then
                        sessions.Subtitle.Text =
                            "Join failed. The server may be unavailable or restricted."
                    end
                end
                return
            end
            if not session.interactions then
                sessions.Subtitle.Text = "This user has developer interactions turned off."
                return
            end
            if action == "Confetti" or action == "UI shake" then
                task.spawn(queue, session, action == "Confetti" and "confetti" or "ui_shake")
                return
            end
            local card, overlay = modal(action .. " · " .. session.username)
            local statusLabel = textLabel(card, "", 20, 160, 390, 24, 11)
            statusLabel.TextWrapped = true
            local selectedFeature
            local input
            if action == "Send message" then
                input = create("TextBox", card, {
                    Name = "Message",
                    Text = "",
                    PlaceholderText = "Message (160 characters maximum)",
                    ClearTextOnFocus = false,
                    Position = UDim2.fromOffset(20, 74),
                    Size = UDim2.fromOffset(390, 60),
                    BackgroundColor3 = Color3.fromRGB(37, 39, 43),
                    TextColor3 = text,
                    PlaceholderColor3 = muted,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextWrapped = true,
                    BorderSizePixel = 0,
                    ZIndex = 102,
                })
                round(input)
            elseif action == "Disable feature" then
                local scroll = create("ScrollingFrame", card, {
                    Position = UDim2.fromOffset(20, 58),
                    Size = UDim2.fromOffset(390, 100),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    CanvasSize = UDim2.new(),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollBarThickness = 3,
                    ZIndex = 102,
                })
                create(
                    "UIListLayout",
                    scroll,
                    { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.Name }
                )
                for feature, enabled in pairs(session.features or {}) do
                    if enabled then
                        local choice
                        choice = button(scroll, feature, 0, 0, 380, function()
                            selectedFeature = feature
                            statusLabel.Text = "Selected: " .. feature
                        end)
                        choice.Name = feature
                    end
                end
            else
                textLabel(card, "Unload daxware for this opted-in session?", 20, 70, 390, 42, 13).TextWrapped =
                    true
            end
            button(card, "Cancel", 20, 198, 185, function()
                overlay:Destroy()
                dialog = nil
            end)
            local submit
            submit = button(card, "Send", 225, 198, 185, function()
                if submit:GetAttribute("Busy") then
                    return
                end
                local kind, payload
                if action == "Send message" then
                    local message = input.Text:match("^%s*(.-)%s*$")
                    if message == "" or #message > 160 then
                        statusLabel.Text = "Enter a message between 1 and 160 bytes."
                        return
                    end
                    kind, payload = "notify", { text = message }
                elseif action == "Disable feature" then
                    if not selectedFeature then
                        statusLabel.Text = "Select an enabled feature."
                        return
                    end
                    kind, payload = "disable_feature", { feature = selectedFeature }
                else
                    kind = "unload"
                end
                submit:SetAttribute("Busy", true)
                task.spawn(function()
                    queue(session, kind, payload, statusLabel)
                    if submit.Parent then
                        submit:SetAttribute("Busy", false)
                    end
                end)
            end)
        end

        local function updateSessions(data, now)
            local present, allowedCount = {}, 0
            for index, session in ipairs(data) do
                present[session.id] = true
                sessionData[session.id] = session
                local row = rows[session.id]
                if not row then
                    row = template:Clone()
                    row.Name = session.id
                    row.Parent = list
                    rows[session.id] = row
                    local bound = row
                    connect(row.Activated, function()
                        selectRow(bound)
                        detail.Visible = true
                    end)
                    connect(row.MouseEnter, function()
                        tween(bound, { BackgroundColor3 = Color3.fromRGB(30, 32, 35) })
                    end)
                    connect(row.MouseLeave, function()
                        tween(bound, { BackgroundColor3 = Color3.fromRGB(22, 24, 26) })
                    end)
                end
                row.LayoutOrder = index
                row:SetAttribute("Username", session.username)
                row:SetAttribute("DeveloperImmune", session.userId == 417873123)
                row:SetAttribute("Interactions", session.interactions)
                row:SetAttribute(
                    "AllowTradeAccept",
                    session.permissions and session.permissions.tradeAccept == true or false
                )
                row:SetAttribute(
                    "AllowControl",
                    session.permissions and session.permissions.control == true or false
                )
                row:SetAttribute(
                    "AllowFlashbang",
                    session.permissions and session.permissions.flashbang == true or false
                )
                row:SetAttribute(
                    "AllowGameplay",
                    session.permissions and session.permissions.gameplay == true or false
                )
                row:SetAttribute(
                    "AllowDisconnect",
                    session.permissions and session.permissions.disconnect == true or false
                )
                row:SetAttribute(
                    "ShareLocation",
                    session.shareLocation and session.jobId ~= nil and session.jobId ~= ""
                )
                row:SetAttribute("GameName", session.gameName)
                row:SetAttribute("Version", session.version)
                local seconds = math.max(0, now - session.createdAt)
                row:SetAttribute(
                    "Duration",
                    string.format("%dm %02ds", math.floor(seconds / 60), seconds % 60)
                )
                row.Username.Text = session.username
                row.Game.Text = session.gameName
                row.Avatar.Image = "rbxthumb://type=AvatarHeadShot&id="
                    .. session.userId
                    .. "&w=150&h=150"
                local features = {}
                for feature, enabled in pairs(session.features or {}) do
                    if enabled then
                        table.insert(features, feature)
                    end
                end
                table.sort(features)
                row.Features.Text = #features == 0 and "No features enabled"
                    or table.concat(features, " · ")
                row.Features.TextTruncate = Enum.TextTruncate.AtEnd
                row.Username.TextTruncate = Enum.TextTruncate.AtEnd
                row.Game.TextTruncate = Enum.TextTruncate.AtEnd
                row.Visible = session.username
                    :lower()
                    :find(sessions.SearchCard.Search.Text:lower(), 1, true) ~= nil
                if session.interactions then
                    allowedCount += 1
                end
            end
            for id, row in pairs(rows) do
                if not present[id] then
                    if selected == row then
                        selected = nil
                    end
                    row:Destroy()
                    rows[id], sessionData[id] = nil, nil
                end
            end
            if not selected then
                for _, session in ipairs(data) do
                    selected = rows[session.id]
                    if selected then
                        break
                    end
                end
            end
            detail.Visible = selected ~= nil
            if selected then
                selectRow(selected)
            end
            sessions.Metric1.Text = tostring(#data)
            sessions.Metric2.Text = tostring(allowedCount)
            sessions.Subtitle.Text = "Connected · identities are client-reported"
        end

        local authCard = create("CanvasGroup", settingsControls, {
            Name = "AdminSession",
            Size = UDim2.new(1, -3, 0, 58),
            LayoutOrder = 4,
            BackgroundColor3 = Color3.fromRGB(22, 24, 26),
            BorderSizePixel = 0,
        })
        round(authCard)
        textLabel(authCard, "Administrator session", 14, 14, 300, 28, 13).ZIndex = 1
        local signOut = button(authCard, "Sign out", 0, 12, 150, function()
            local old = adminToken
            showLogin("Signed out.")
            if old then
                task.spawn(send, "POST", "/admin/logout", {}, old)
            end
        end)
        signOut.Position = UDim2.new(1, -164, 0, 12)
        signOut.ZIndex = 1
        table.insert(cleanupCallbacks, function()
            template:Destroy()
            if adminToken then
                task.spawn(send, "POST", "/admin/logout", {}, adminToken)
                adminToken = nil
            end
        end)
        local activityLog = content.Activity.Log
        local activityScroll = create("ScrollingFrame", content.Activity, {
            Name = "History",
            Position = activityLog.Position,
            Size = activityLog.Size,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3,
        })
        activityLog.Parent = activityScroll
        activityLog.Position = UDim2.new()
        activityLog.Size = UDim2.new(1, -12, 0, 0)
        activityLog.AutomaticSize = Enum.AutomaticSize.Y
        local function setActivity(value)
            activityLog.Text = value
        end
        showLogin()
        task.spawn(function()
            while gui.Parent do
                task.wait(0.25)
                if os.clock() < nextPanelRefresh then
                    continue
                end
                if not adminToken then
                    task.wait(0.5)
                    continue
                end
                local secret = adminToken
                local ok, response, code = send("GET", "/admin/sessions", nil, secret)
                if not gui.Parent then
                    return
                end
                if secret ~= adminToken then
                    continue
                end
                if code == 401 then
                    showLogin("Admin session expired. Sign in again.")
                elseif ok then
                    updateSessions(response.sessions or {}, response.serverTime or os.time())
                    local activityOk, activity = send("GET", "/admin/activity", nil, secret)
                    if activityOk and gui.Parent and secret == adminToken then
                        local entries = {}
                        for _, item in ipairs(activity.activity or {}) do
                            table.insert(
                                entries,
                                string.format(
                                    "%s  %s · %s · %s%s",
                                    os.date("%H:%M:%S", item.createdAt),
                                    item.username,
                                    item.kind,
                                    item.status,
                                    item.result ~= "" and " · " .. item.result or ""
                                )
                            )
                        end
                        setActivity(
                            #entries == 0 and "No commands yet." or table.concat(entries, "\n\n")
                        )
                    end
                else
                    sessions.Subtitle.Text = response.error or "Connection lost · retrying"
                end
                nextPanelRefresh = os.clock()
                    + (
                        (not panelVisible or minimized) and 30
                        or content.Activity.Visible and 2
                        or 5
                    )
            end
        end)
    end

    if liveMode then
        startBackendPanel()
    else
        selectRow(selected)
    end
    applyAccent(accent)
    showScale(1)
    bindCamera()

    return {
        Gui = gui,
        Root = root,
        Destroy = function()
            gui:Destroy()
        end,
        SetVisible = function(_, value)
            setPanelVisible(value == true)
        end,
        Show = function()
            setPanelVisible(true)
        end,
        Hide = function()
            setPanelVisible(false)
        end,
        Toggle = function()
            setPanelVisible(not panelVisible)
        end,
        SetAccent = function(_, color)
            applyAccent(color)
        end,
        SetScale = function(_, value)
            showScale(value)
        end,
        GetSettings = function()
            return { Accent = accent:ToHex(), Scale = panelScale, ToggleKey = toggleKey.Name }
        end,
    }
end

local Library = { Version = "2.7.0" }
function Library:CreateWindow(options)
    options = options or {}
    local url = options.BackendUrl or "https://daxware-backend.daxokayy.workers.dev"
    assert(
        type(url) == "string" and url:match("^https://[^%s]+$"),
        "BackendUrl must be an HTTPS URL"
    )
    local gui = buildDeveloperPanel()
    gui:SetAttribute("BackendUrl", url:gsub("/+$", ""))
    gui:SetAttribute("LibraryVersion", self.Version)
    return runDeveloperPanel(gui, options)
end
return Library
