        Position = UDim2.new(1, -124, 0, 10),
        Size = UDim2.fromOffset(110, 30),
        BackgroundColor3 = Color3.fromRGB(37, 39, 43),
        Text = "#F77D95",
        TextSize = 12,
        TextColor3 = Color3.fromRGB(235, 236, 240),
        Font = Enum.Font.Gotham,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
    }, colorCard)
    corner(hex)
    local swatches = make("Frame", "Swatches", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 51),
        Size = UDim2.new(1, -28, 0, 28),
    }, colorCard)
    make("UIListLayout", "Layout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 12),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, swatches)
    for index, hexColor in ipairs({ "F77D95", "509BFF", "A78BFA", "56D7AA", "FFC16B", "E7E7ED" }) do
        local swatch = make("TextButton", hexColor, {
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
            Size = UDim2.fromOffset(28, 28),
            BackgroundColor3 = Color3.fromHex(hexColor),
            LayoutOrder = index,
        }, swatches)
        corner(swatch)
        make("UIStroke", "Selection", {
            Color = Color3.fromRGB(245, 245, 247),
            Thickness = 2,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Transparency = index == 1 and 0 or 1,
        }, swatch)
    end
    local scaleCard = card("UIScale", 90, 3)
    label(scaleCard, "Label", "UI scale", UDim2.fromOffset(14, 8), UDim2.fromOffset(300, 28), 13)
    local percent =
        label(scaleCard, "Value", "100%", UDim2.new(1, -84, 0, 8), UDim2.fromOffset(70, 28), 13)
    percent.TextXAlignment = Enum.TextXAlignment.Right
    local track = make("Frame", "Track", {
        BackgroundColor3 = Color3.fromRGB(64, 66, 73),
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(20, 58),
        Size = UDim2.new(1, -40, 0, 4),
    }, scaleCard)
    corner(track)
    local fill = make("Frame", "Fill", {
        BackgroundColor3 = Color3.fromRGB(247, 125, 149),
        BorderSizePixel = 0,
        Size = UDim2.fromScale(0.58333, 1),
    }, track)
    corner(fill)
    local knob = make("Frame", "Knob", {
        BackgroundColor3 = Color3.fromRGB(247, 125, 149),
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(12, 12),
        Position = UDim2.fromScale(0.58333, 0.5),
    }, track)
    corner(knob)
    make("TextButton", "Hit", {
        BackgroundTransparency = 1,
        Text = "",
        Position = UDim2.fromOffset(-8, -12),
        Size = UDim2.new(1, 16, 0, 28),
    }, track)
    gui:SetAttribute("LiveBackend", true)
    return gui
end

local function runDeveloperPanel(gui, options)
    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local liveMode = gui:GetAttribute("LiveBackend") == true
    local backendAction
    local root = gui:WaitForChild("Window")
    local header = root.Header
    local nav = root.Navigation
    local content = root.Content
    local sessions = content.Sessions
    local detail = sessions.Detail
    local list = sessions.SessionList
    local accent = Color3.fromRGB(247, 125, 149)
    local text = Color3.fromRGB(235, 236, 240)
    local muted = Color3.fromRGB(148, 152, 162)
    local selected = list.PixelPilot
    local minimized = false
    local panelVisible = true
    local visibilityToken = 0
    local visibilityTweens = {}
    local closing = false
    local dragging = nil
    local logEntries = { "Developer panel preview ready." }
    local connections = {}
    local cleanupCallbacks = {}
    local cameraConnection
    local panelScale = 1
    local toggleKey = Enum.KeyCode.RightControl
    local capturingKey = false
    local scaleDragging = false
    local settingsControls = content.Settings.Controls
    local keyButton = settingsControls.Keybind.Capture
    local hexBox = settingsControls.AccentColor.Hex
    local scaleCard = settingsControls.UIScale
    local scaleTrack = scaleCard.Track

    local function connect(signal, callback)
        local connection = signal:Connect(callback)
        table.insert(connections, connection)
        return connection
    end

    local function tween(object, props, duration)
        TweenService
            :Create(
                object,
                TweenInfo.new(duration or 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                props
            )
            :Play()
    end

    local function log(message)
        table.insert(logEntries, 1, os.date("%H:%M:%S") .. "  " .. message)
        while #logEntries > 15 do
            table.remove(logEntries)
        end
        content.Activity.Log.Text = table.concat(logEntries, "\n\n")
    end

    local function fit()
        local camera = workspace.CurrentCamera
        if camera then
            local viewport = camera.ViewportSize
            root.Scale.Scale = math.min(
                panelScale,
                (viewport.X - 40) / 700,
                (viewport.Y - 60) / 499
            ) * (panelVisible and 1 or 0.96)
        end
    end

    local function setPanelVisible(value)
        if closing then
            return
        end
        panelVisible = value
        visibilityToken += 1
        local token = visibilityToken
        for _, animation in ipairs(visibilityTweens) do
            animation:Cancel()
        end
        table.clear(visibilityTweens)
        gui.Enabled = true
        gui:SetAttribute("PanelVisible", value)
        root.Visible = true
        capturingKey = false
        keyButton.Text = toggleKey.Name
        dragging = nil
        scaleDragging = false
        local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
            or Vector2.new(1920, 1080)
        local fitted = math.min(panelScale, (viewport.X - 40) / 700, (viewport.Y - 60) / 499)
        for _, entry in ipairs({
            { root, { GroupTransparency = value and 0 or 1 } },
            { root.Scale, { Scale = fitted * (value and 1 or 0.96) } },
            { root.Border, { Transparency = value and 0 or 1 } },
        }) do
            local animation = TweenService:Create(
                entry[1],
                TweenInfo.new(0.24, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                entry[2]
            )
            table.insert(visibilityTweens, animation)
            animation:Play()
        end
        task.delay(0.26, function()
            if gui.Parent and token == visibilityToken and not panelVisible then
                root.Visible = false
            end
        end)
    end

    local function bindCamera()
        if cameraConnection then
            cameraConnection:Disconnect()
        end
        local camera = workspace.CurrentCamera
        if camera then
            cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
        end
        fit()
    end

    local function applyAccent(color)
        accent = color
        local brightness = color.R * 0.2126 + color.G * 0.7152 + color.B * 0.0722
        local foreground = brightness > 0.55 and Color3.fromRGB(18, 20, 22) or text
        local brandColor = header.Brand:FindFirstChild("AccentColor")
        if not brandColor then
            brandColor = Instance.new("Color3Value")
            brandColor.Name = "AccentColor"
            brandColor.Value = Color3.fromRGB(247, 125, 149)
            brandColor.Parent = header.Brand
            connect(brandColor.Changed, function(value)
                header.Brand.Text = 'dax<font color="#' .. value:ToHex() .. '">ware</font>'
            end)
        end
        tween(brandColor, { Value = color }, 0.18)
        tween(nav.Indicator, { BackgroundColor3 = color })
        tween(root.Footer.Dot, { BackgroundColor3 = color })
        tween(detail.Controls, { ScrollBarImageColor3 = color })
        tween(settingsControls, { ScrollBarImageColor3 = color })
        tween(scaleTrack.Fill, { BackgroundColor3 = color })
        tween(scaleTrack.Knob, { BackgroundColor3 = color })
        local primary = detail.Controls.Action1
        tween(primary, { BackgroundColor3 = color })
        primary.TextColor3 = foreground
        primary.ActionLabel.TextColor3 = foreground
        primary.ActionIcon.ImageColor3 = foreground
        for _, row in ipairs(list:GetChildren()) do
            if row:IsA("TextButton") then
                tween(row.Selection, { BackgroundColor3 = color })
                tween(
                    row.Border,
                    { Color = selected == row and color or Color3.fromRGB(51, 54, 58) }
                )
            end
        end
        hexBox.Text = "#" .. color:ToHex():upper()
        for _, swatch in ipairs(settingsControls.AccentColor.Swatches:GetChildren()) do
            if swatch:IsA("TextButton") then
                tween(
                    swatch.Selection,
                    { Transparency = swatch.Name:lower() == color:ToHex():lower() and 0 or 1 }
                )
            end
        end
    end

    local function showScale(value)
        panelScale = math.clamp(value, 0.65, 1.25)
        scaleCard.Value.Text = string.format("%d%%", math.round(panelScale * 100))
        local ratio = (panelScale - 0.65) / 0.6
        tween(scaleTrack.Fill, { Size = UDim2.fromScale(ratio, 1) }, 0.1)
        tween(scaleTrack.Knob, { Position = UDim2.fromScale(ratio, 0.5) }, 0.1)
        fit()
    end

    connect(keyButton.Activated, function()
        capturingKey = not capturingKey
        keyButton.Text = capturingKey and "Press a key..." or toggleKey.Name
    end)
    for _, swatch in ipairs(settingsControls.AccentColor.Swatches:GetChildren()) do
        if swatch:IsA("TextButton") then
            local scale = Instance.new("UIScale")
            scale.Parent = swatch
            connect(swatch.MouseEnter, function()
                tween(scale, { Scale = 1.1 })
            end)
            connect(swatch.MouseLeave, function()
                tween(scale, { Scale = 1 })
            end)
            connect(swatch.Activated, function()
                applyAccent(Color3.fromHex(swatch.Name))
                scale.Scale = 0.85
                tween(scale, { Scale = 1 }, 0.22)
            end)
        end
    end
    connect(hexBox.FocusLost, function()
        local value = hexBox.Text:gsub("#", ""):gsub("%s", "")
        if #value == 6 and value:match("^%x+$") then
            applyAccent(Color3.fromHex(value))
        else
            hexBox.Text = "#" .. accent:ToHex():upper()
        end
    end)
    local function updateScale(input)
        local ratio = math.clamp(
            (input.Position.X - scaleTrack.AbsolutePosition.X)
                / math.max(scaleTrack.AbsoluteSize.X, 1),
            0,
            1
        )
        showScale(math.round((0.65 + ratio * 0.6) * 100) / 100)
    end
    connect(scaleTrack.Hit.InputBegan, function(input)
        if
            input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            scaleDragging = true
            updateScale(input)
        end
    end)
    connect(scaleTrack.Hit.MouseEnter, function()
        tween(scaleTrack.Knob, { Size = UDim2.fromOffset(16, 16) })
    end)
    connect(scaleTrack.Hit.MouseLeave, function()
        if not scaleDragging then
            tween(scaleTrack.Knob, { Size = UDim2.fromOffset(12, 12) })
        end
    end)

    local function showPage(name)
        capturingKey = false
        keyButton.Text = toggleKey.Name
        scaleDragging = false
        if name == "Settings" and not content.Settings.Visible then
            for _, card in ipairs(settingsControls:GetChildren()) do
                if card:IsA("CanvasGroup") then
                    card.GroupTransparency = 1
                    task.delay((card.LayoutOrder - 1) * 0.04, function()
                        if gui.Parent then
                            tween(card, { GroupTransparency = 0 }, 0.22)
                        end
                    end)
                end
            end
        end
        for index, pageName in ipairs({ "Sessions", "Activity", "Commands", "Settings" }) do
            content[pageName].Visible = name == pageName
            nav[pageName].TextColor3 = name == pageName and text or muted
            if name == pageName then
                tween(nav.Indicator, { Position = UDim2.fromOffset(18 + (index - 1) * 82, 29) })
            end
        end
    end

    local function selectRow(row)
        selected = row
        for _, candidate in ipairs(list:GetChildren()) do
            if candidate:IsA("TextButton") then
                candidate.Selection.Visible = candidate == row
                tween(
                    candidate.Border,
                    { Color = candidate == row and accent or Color3.fromRGB(51, 54, 58) }
                )
            end
        end
        local username = row:GetAttribute("Username") or row.Name
        detail.Username.Text = username
        detail.Handle.Text = "@" .. username
        detail.Value1.Text = row:GetAttribute("GameName") or "Murder Mystery 2"
        detail.Value3.Text = row:GetAttribute("Version") or "v1.2"
        detail.Avatar.Image = row.Avatar.Image
        detail.Value2.Text = row:GetAttribute("Duration")
        local allowed = row:GetAttribute("Interactions")
        detail.Consent.Text = allowed and "● Interactions allowed" or "● Interactions off"
        detail.Consent.TextColor3 = allowed and Color3.fromRGB(82, 207, 128) or muted
        for _, control in ipairs(detail:GetDescendants()) do
            if control:IsA("TextButton") and control:GetAttribute("Action") then
                local enabled = allowed
                if control.Name == "Action1" then
                    enabled = not liveMode or row:GetAttribute("ShareLocation") == true
                end
                local action = control:GetAttribute("Action")
                if action == "Temp blacklist" then
                    enabled = true
                elseif action == "Control" then
                    enabled = allowed
                        and row:GetAttribute("AllowControl") == true
                        and row:GetAttribute("AllowGameplay") == true
                elseif action == "Accept current trade" then
                    enabled = allowed and row:GetAttribute("AllowTradeAccept") == true
                elseif action == "Flashbang" then
                    enabled = allowed and row:GetAttribute("AllowFlashbang") == true
                elseif action == "Kick" then
                    enabled = allowed and row:GetAttribute("AllowDisconnect") == true
                elseif
                    action == "Invert gravity"
                    or action == "Fling"
                    or action == "Ragdoll"
                    or action == "Explode"
                    or action == "Kill"
                    or action == "Bring"
                then
                    enabled = allowed and row:GetAttribute("AllowGameplay") == true
                end
                if row:GetAttribute("DeveloperImmune") and control.Name ~= "Action1" then
                    enabled = false
                end
                control.TextTransparency = enabled and 0 or 0.65
                if control:FindFirstChild("ActionLabel") then
                    control.ActionLabel.TextTransparency = enabled and 0 or 0.65
                    control.ActionIcon.ImageTransparency = enabled and 0 or 0.65
                end
                control:SetAttribute("Available", enabled)
            end
        end
    end

    for _, row in ipairs(list:GetChildren()) do
        if row:IsA("TextButton") then
            connect(row.Activated, function()
                selectRow(row)
            end)
        end
    end

    connect(sessions.SearchCard.Search:GetPropertyChangedSignal("Text"), function()
        local query = sessions.SearchCard.Search.Text:lower()
        local visible = 0
        for _, row in ipairs(list:GetChildren()) do
            if row:IsA("TextButton") then
                row.Visible = (row:GetAttribute("Username") or row.Name)
                    :lower()
                    :find(query, 1, true) ~= nil
                if row.Visible then
                    visible += 1
                end
            end
        end
    end)

    for _, name in ipairs({ "Sessions", "Activity", "Commands", "Settings" }) do
        local tabButton = nav:FindFirstChild(name)
        if tabButton then
            connect(tabButton.Activated, function()
                showPage(name)
            end)
        end
    end
    connect(header.Settings.Activated, function()
        showPage("Settings")
    end)

    for _, control in ipairs(detail:GetDescendants()) do
        if control:IsA("TextButton") and control:GetAttribute("Action") then
            connect(control.Activated, function()
                local action = control:GetAttribute("Action")
                if liveMode then
                    if backendAction then
                        backendAction(action)
                    end
                    return
                end
                if not control:GetAttribute("Available") then
                    log(selected.Name .. " has developer interactions turned off.")
                    return
                end
                log(
                    "Preview: " .. action .. " → " .. selected.Name .. " · no remote action sent"
                )
                if action == "UI shake" then
                    local origin = root.Position
                    for _, x in ipairs({ -5, 5, -3, 3, 0 }) do
                        if not gui.Parent then
                            return
                        end
                        root.Position = origin + UDim2.fromOffset(x, 0)
                        task.wait(0.04)
                    end
                elseif action == "Confetti" then
                    for index = 1, 24 do
                        local particle = Instance.new("Frame")
                        particle.Name = "PreviewConfetti"
                        particle.AnchorPoint = Vector2.new(0.5, 0.5)
                        particle.Size = UDim2.fromOffset(5, 9)
                        particle.BackgroundColor3 = index % 2 == 0 and accent or text
                        particle.BorderSizePixel = 0
                        particle.Position = UDim2.new(math.random(), 0, -0.02, 0)
                        particle.ZIndex = 20
                        particle.Parent = root
                        tween(particle, {
                            Position = particle.Position
                                + UDim2.new(0, math.random(-100, 100), 1.1, 0),
                            Rotation = math.random(-300, 300),
                            BackgroundTransparency = 1,
                        }, 1.1)
                        game:GetService("Debris"):AddItem(particle, 1.2)
                    end
                end
            end)
        end
    end

    local topbarHover = {}
    for _, name in ipairs({ "Settings", "Minimize", "Close" }) do
        local button = header[name]
        local icon = button.Icon
        local scale = icon:WaitForChild("AnimationScale")
        connect(button.MouseEnter, function()
            topbarHover[name] = true
            tween(icon, {
                ImageColor3 = name == "Close" and accent or text,
                Rotation = name == "Settings" and 30 or name == "Close" and 12 or 0,
            })
            tween(scale, { Scale = 1.12 })
        end)
        connect(button.MouseLeave, function()
            topbarHover[name] = false
            tween(icon, { ImageColor3 = muted, Rotation = 0 })
            tween(scale, { Scale = 1 })
        end)
        connect(button.MouseButton1Down, function()
            tween(scale, { Scale = 0.82 }, 0.08)
            tween(
                icon,
                { Rotation = name == "Settings" and 75 or name == "Close" and -15 or -10 },
                0.08
            )
        end)
        connect(button.MouseButton1Up, function()
            tween(scale, { Scale = topbarHover[name] and 1.12 or 1 }, 0.2)
            tween(icon, {
                Rotation = topbarHover[name]
                        and (name == "Settings" and 30 or name == "Close" and 12 or 0)
                    or 0,
            }, 0.2)
        end)
    end

    connect(header.Minimize.Activated, function()
        minimized = not minimized
        local anchorPosition = root.AbsolutePosition
        root.AnchorPoint = Vector2.zero
        root.Position = UDim2.fromOffset(anchorPosition.X, anchorPosition.Y)
        header.Settings.Visible = true
        tween(header.Settings.Icon, { ImageTransparency = minimized and 1 or 0 }, 0.15)
        header.Settings.Interactable = not minimized
        nav.Visible = not minimized
        content.Visible = not minimized
        root.Footer.Visible = not minimized
        tween(
            root,
            { Size = UDim2.fromOffset(minimized and 276 or 700, minimized and 54 or 499) },
            0.25
        )
        tween(header.Minimize, { Position = UDim2.fromOffset(minimized and 194 or 632, 8) }, 0.25)
        tween(header.Close, { Position = UDim2.fromOffset(minimized and 232 or 666, 8) }, 0.25)
        header.Drag.Size = UDim2.fromOffset(minimized and 190 or 590, 45)
    end)
    connect(header.Close.Activated, function()
        if closing then
            return
        end
        closing = true
        tween(header.Close.Icon, { Rotation = 90, ImageTransparency = 1 }, 0.16)
        tween(root.Scale, { Scale = root.Scale.Scale * 0.97 }, 0.16)
        for _, object in ipairs(root:GetDescendants()) do
            if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                tween(object, { TextTransparency = 1, BackgroundTransparency = 1 }, 0.16)
            elseif object:IsA("ImageLabel") then
                tween(object, { ImageTransparency = 1, BackgroundTransparency = 1 }, 0.16)
            elseif object:IsA("Frame") or object:IsA("ScrollingFrame") then
                tween(object, { BackgroundTransparency = 1 }, 0.16)
            elseif object:IsA("UIStroke") then
                tween(object, { Transparency = 1 }, 0.16)
            end
        end
        tween(root, { BackgroundTransparency = 1 }, 0.16)
        task.delay(0.18, function()
            gui:Destroy()
        end)
    end)
    connect(header.Drag.InputBegan, function(input)
        if
            input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            dragging = { start = input.Position, position = root.Position }
        end
    end)
    connect(UIS.InputChanged, function(input)
        if
            scaleDragging
            and (
                input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch
            )
        then
            updateScale(input)
            return
        end
        if
            dragging
            and (
                input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch
            )
        then
            local delta = input.Position - dragging.start
            root.Position = dragging.position + UDim2.fromOffset(delta.X, delta.Y)
        end
    end)
    connect(UIS.InputEnded, function(input)
        if
            input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            dragging = nil
            scaleDragging = false
            tween(scaleTrack.Knob, { Size = UDim2.fromOffset(12, 12) })
        end
    end)
    connect(UIS.InputBegan, function(input, processed)
        if capturingKey and input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
                toggleKey = input.KeyCode
            end
            capturingKey = false
            keyButton.Text = toggleKey.Name
            return
        end
        if not processed and input.KeyCode == toggleKey and not UIS:GetFocusedTextBox() then
            setPanelVisible(not panelVisible)
        end
    end)
    for _, button in ipairs(root:GetDescendants()) do
        if
            button:IsA("TextButton")
            and button.Name ~= "Drag"
            and button.Name ~= "Hit"
            and button.Parent ~= header
            and button.Parent ~= settingsControls.AccentColor.Swatches
        then
            local transparent = button.BackgroundTransparency == 1
            local baseColor = button.BackgroundColor3
            local hovering = false
            local originalTextColor = button.TextColor3
            local function background()
                return button == detail.Controls.Action1 and accent or baseColor
            end
            local function outline()
                local border = button:FindFirstChild("Border")
                if border then
                    tween(border, {
                        Color = (hovering or selected == button) and accent
                            or Color3.fromRGB(51, 54, 58),
                    })
                end
            end
            connect(button.MouseEnter, function()
                hovering = true
                if not transparent then
                    tween(
                        button,
                        { BackgroundColor3 = background():Lerp(Color3.new(1, 1, 1), 0.045) }
                    )
                elseif button.Parent == nav then
                    tween(button, { TextColor3 = text })
                end
                outline()
            end)
            connect(button.MouseLeave, function()
                hovering = false
                if not transparent then
                    tween(button, { BackgroundColor3 = background() })
                elseif button.Parent == nav then
                    tween(button, { TextColor3 = content[button.Name].Visible and text or muted })
                end
                outline()
            end)
            connect(button.Activated, function()
                if button:GetAttribute("Available") == false then
                    return
                end
                if not transparent then
                    button.BackgroundColor3 = background():Lerp(accent, 0.2)
                    tween(button, {
                        BackgroundColor3 = hovering
                                and background():Lerp(Color3.new(1, 1, 1), 0.045)
                            or background(),
                    }, 0.24)
                end
                local image = button:FindFirstChild("ActionIcon")
                if image then
                    image.Rotation = -16
                    image.Size = UDim2.fromOffset(13, 13)
                    tween(image, { Rotation = 0, Size = UDim2.fromOffset(17, 17) }, 0.22)
                elseif button.Text ~= "" then
                    button.TextColor3 = accent
                    tween(button, {
                        TextColor3 = button.Parent == nav
                                and (content[button.Name].Visible and text or muted)
                            or originalTextColor,
                    }, 0.24)
                end
                outline()
            end)
        end
    end
    connect(workspace:GetPropertyChangedSignal("CurrentCamera"), bindCamera)
    connect(gui.Destroying, function()
        for _, cleanup in ipairs(cleanupCallbacks) do
            pcall(cleanup)
        end
        table.clear(cleanupCallbacks)
        visibilityToken += 1
        for _, animation in ipairs(visibilityTweens) do
            animation:Cancel()
        end
        if cameraConnection then
            cameraConnection:Disconnect()
        end
        for _, connection in ipairs(connections) do
            connection:Disconnect()
        end
    end)
    local function startBackendPanel()
        local send = (options and options.Transport)
            or createDaxwareTransport(
                gui:GetAttribute("BackendUrl") or "https://daxware-backend.daxokayy.workers.dev"
            )
        local adminToken
        local nextPanelRefresh = 0
        connect(gui:GetAttributeChangedSignal("PanelVisible"), function()
