local function createDaxwareTransport(baseUrl)
    local http = game:GetService("HttpService")
    local sendRequest = request or http_request or (syn and syn.request)
    return function(method, path, data, token)
        if type(sendRequest) ~= "function" then
            return false, { error = "This executor does not provide request()" }, 0
        end
        local headers = { ["Content-Type"] = "application/json" }
        if token then
            headers.Authorization = "Bearer " .. token
        end
        local options = { Url = baseUrl .. path, Method = method, Headers = headers }
        if data then
            options.Body = http:JSONEncode(data)
        end
        local ok, response = pcall(sendRequest, options)
        if not ok or type(response) ~= "table" then
            return false, { error = "Could not reach daxware backend" }, 0
        end
        local status = tonumber(response.StatusCode) or 0
        local decoded, value = pcall(http.JSONDecode, http, response.Body or "")
        if not decoded or type(value) ~= "table" then
            return false, { error = "Backend returned an invalid response" }, status
        end
        return status >= 200 and status < 300, value, status
    end
end

